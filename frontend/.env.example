# =============================================================================
# Construction ERP — Frontend environment (Vercel / local)
# Copy to frontend/.env.local for local dev, or set in Vercel project settings.
# =============================================================================

# Backend API base URL including /api prefix
# Local: backend default port 3001 (use 3008 if Hyper-V blocks 3001 on Windows)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Production example (Render backend):
# NEXT_PUBLIC_API_URL=https://construction-erp-api.onrender.com/api
