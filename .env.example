# Database
DATABASE_URL="postgresql://erp:password@localhost:5432/construction_erp?schema=public"

# Backend
NODE_ENV=development
# Use 3008 on Windows if 3001 fails (Hyper-V reserves ports 2908–3007)
PORT=3001
API_PREFIX=api

# JWT (generate secure values for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (required for email notification queue)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Minio / S3
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=erp_minio
MINIO_SECRET_KEY=erp_minio_dev_password
MINIO_USE_SSL=false

# Mail (dev - optional)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@construction-erp.local
NOTIFICATION_RETENTION_DAYS=90

# Seed admin (override in production)
SEED_ADMIN_EMAIL=admin@company.local
SEED_ADMIN_PASSWORD=Admin@12345
