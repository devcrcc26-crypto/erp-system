# =============================================================================
# Construction ERP — Backend environment (Render / local)
# Copy to backend/.env for local dev, or set in Render dashboard for production.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3001
API_PREFIX=api

# Frontend origin for CORS (must match Vercel production URL exactly)
CORS_ORIGIN=http://localhost:3000

# Used in auth emails (activation, password reset links)
FRONTEND_URL=http://localhost:3000

# Rate limit: requests per minute per IP (production only; dev/test skip throttling)
THROTTLE_LIMIT=300

# --- Database ---
# Local Docker Compose (port 5433):
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5433/construction_erp?schema=public"

# --- Supabase (set DATABASE_URL + optional DIRECT_URL in prisma.config.ts / .env) ---
#
# IPv4 vs IPv6 (common on Windows / home networks):
# - Direct host db.[PROJECT_REF].supabase.co:5432 → often IPv6-only (free tier)
# - Session pooler :5432 on pooler host → IPv4 (use for app + migrate + seed)
# - Transaction pooler :6543 → serverless only; needs ?pgbouncer=true (not 5432)
# - Direct db.[PROJECT_REF].supabase.co:5432 → often IPv6-only
#
# IPv4-only (session pooler on port 5432). Cap Prisma pool — Supabase session
# mode is often pool_size: 15; Nest watch + parallel queries can exhaust it.
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=20&connect_timeout=60"
# DATABASE_CONNECTION_LIMIT=5
#
# If you have IPv6 or IPv4 add-on (direct host):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# (or use db.[PROJECT_REF].supabase.co:5432 with user postgres)
#
# Option C — run migrations on Render (preDeployCommand) where IPv6 works; keep pooler for app.
#
# Neon (recommended in render.yaml): single DATABASE_URL with ?sslmode=require — no DIRECT_URL needed
# if DIRECT_URL is unset in .env / prisma.config.ts (Neon pooled URL supports migrations).

# --- JWT (REQUIRED — generate unique secrets for production, min 32 chars) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (enable on Render when using notification queue / BullMQ workflows) ---
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Object storage (Minio local; S3-compatible provider in production) ---
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=erp_minio
MINIO_SECRET_KEY=erp_minio_dev_password
MINIO_USE_SSL=false

# --- Mail ---
# Local dev: Mailpit (docker compose) on port 1025
# Production (Resend): set RESEND_API_KEY + MAIL_FROM (no SMTP host required)
RESEND_API_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@construction-erp.local

# --- Notifications ---
NOTIFICATION_RETENTION_DAYS=90

# Local-only: auto-approve every approval tier after submit (ignored unless DB host is localhost/127.0.0.1)
AUTO_APPROVE_ALL=false
# AUTO_APPROVE_ACTOR_ID=

# --- Seed (local / first deploy only — not read at runtime by NestJS) ---
SEED_ADMIN_EMAIL=admin@company.local
SEED_ADMIN_PASSWORD=Admin@12345
# Set to false on production if you only want roles/permissions/admin (no demo projects)
SEED_PM_DEMO=true
