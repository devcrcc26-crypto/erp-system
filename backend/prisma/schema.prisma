  createdAt          DateTime @default(now()) @map("created_at")

  issue            Issue     @relation(fields: [issueId], references: [id])
  responder        User      @relation(fields: [respondedBy], references: [id])
  responseDocument Document? @relation("IssueResponseDocument", fields: [responseDocumentId], references: [id])

  @@index([issueId], map: "idx_issue_response_issue_id")
  @@index([responseDocumentId], map: "idx_issue_response_response_document_id")
  @@map("issue_response")
}

