  submittedAt        DateTime?          @map("submitted_at")
  completedAt        DateTime?          @map("completed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  createdBy          String             @map("created_by")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  updatedBy          String             @map("updated_by")
  deletedAt          DateTime?          @map("deleted_at")
  deletedBy          String?            @map("deleted_by")

  company          Company          @relation(fields: [companyId], references: [id])
  employee         User             @relation("AssetRequestEmployee", fields: [employeeId], references: [id])
  approvalRequest  ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  fulfilledByAsset CompanyAsset?    @relation("AssetRequestFulfilledBy", fields: [fulfilledByAssetId], references: [id])
  attachmentFolder DocumentFolder?  @relation(fields: [attachmentFolderId], references: [id])
  creator          User             @relation("AssetRequestCreator", fields: [createdBy], references: [id])
  updater          User             @relation("AssetRequestUpdater", fields: [updatedBy], references: [id])
  assetAssignments AssetAssignment[]

  @@unique([companyId, requestNumber])
  @@index([companyId], map: "idx_asset_request_company")
  @@index([employeeId], map: "idx_asset_request_employee")
  @@index([status], map: "idx_asset_request_status")
  @@index([companyId, deletedAt], map: "idx_asset_request_company_deleted")
  @@map("asset_request")
}

enum AssetRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  FULFILLED
}

enum ExitDirection {
    ENTRANCE
    EXIT
}

enum ExitPermitStatus {
    DRAFT
    SUBMITTED
    IN_REVIEW
    APPROVED
    REJECTED
    RETURNED
    CANCELLED
}


model ExitPermit {
id                  String             @id @default(uuid())
companyId           String             @map("company_id")
departmentId        String?             @map("department_id")
employeeId          String             @map("employee_id")
requestNumber       String             @map("request_number")
direction           ExitDirection      @default(EXIT)
date                DateTime           @map("date") @db.Date
status              ExitPermitStatus   @default(DRAFT)
approvalRequestId   String?            @unique @map("approval_request_id")
attachmentFolderId  String?            @map("attachment_folder_id")
completedAt         DateTime?          @map("completed_at")
submittedAt         DateTime?          @map("submitted_at")
submittedBy         String?            @map("submitted_by")
isOnBehalf          Boolean            @default(false) @map("is_on_behalf")
createdBy           String             @map("created_by")
updatedBy           String             @map("updated_by")
createdAt           DateTime           @default(now()) @map("created_at")
updatedAt           DateTime          @updatedAt @map("updated_at") @default(now())
deletedAt           DateTime?          @map("deleted_at")
deletedBy           String?            @map("deleted_by")


company             Company            @relation(fields: [companyId], references: [id])
employee            User               @relation("ExitPermitEmployee", fields: [employeeId], references: [id])
creator             User               @relation("ExitPermitCreator", fields: [createdBy], references: [id])
submitter           User?              @relation("ExitPermitSubmitter", fields: [submittedBy], references: [id])
department          Department?         @relation(fields: [departmentId], references: [id])
approvalRequest     ApprovalRequest?   @relation(fields: [approvalRequestId], references: [id])
attachmentFolder    DocumentFolder?    @relation(fields: [attachmentFolderId], references: [id])
items               ExitPermitItem[]   

@@unique([companyId, requestNumber])
@@index([requestNumber], map: "idx_exit_permit_company")
@@index([employeeId], map: "idx_exit_permit_employee")
@@index([status], map: "idx_exit_permit_status")
@@index([companyId, createdAt], map: "idx_exit_permit_company_created")
@@index([companyId, deletedAt], map: "idx_exit_permit_company_deleted")
@@index([departmentId], map: "idx_exit_permit_department")
@@index([submittedBy], map: "idx_exit_permit_submitted_by")
@@index([isOnBehalf], map: "idx_exit_permit_on_behalf")
@@map("exit_permit")
}

model ExitPermitItem {
    id                 String             @id @default(uuid())
    requestId          String             @map("request_id")
    itemName           String             @map("item_name")  
    issue              String?
    quantity           Decimal            @default(1) @db.Decimal(10, 2)
    unit               String?                   
    documentId         String?             @map("document_id")
    createdAt          DateTime            @default(now()) @map("created_at")
    updatedAt          DateTime            @updatedAt @map("updated_at")

    request            ExitPermit           @relation(fields: [requestId], references: [id])
    image              Document?             @relation("ExitPermitItemDocument", fields: [documentId], references: [id])

    @@index([requestId], map: "idx_exit_permit_item_request")
    @@index([documentId], map: "idx_exit_permit_item_document")
    @@map("exit_permit_item")

}

// ─── Employee Evaluation ──────────────────────────────────────────────────────

enum EvaluationCycleStatus {
  DRAFT
  ACTIVE
  CLOSED

  @@map("evaluation_cycle_status")
}

enum EvaluationStatus {
  PENDING
  SELF_ASSESSED
  TEAM_LEAD_ASSESSED
  DISCIPLINE_ASSESSED
  RESULT_SHARED
  ACCEPTED
  DISPUTED
  DL_UPHELD
  DL_ADJUSTED
  ESCALATED
  HR_DECIDED
  LOCKED

  @@map("evaluation_status")
}

enum EvaluationStage {
  SELF
  TEAM_LEAD
  DISCIPLINE_LEAD
  HR

  @@map("evaluation_stage")
}

enum EvaluationDisputeStage {
  SUBMITTED_TO_DL
  DL_RESPONDED
  ESCALATED_TO_HR
  HR_DECIDED

  @@map("evaluation_dispute_stage")
}

/**
 * Versioned evaluation form template - created by HR or Discipline Lead.
 * A new version is created when the form changes so old evaluations
 * keep their original criteria.
 */
model EvaluationTemplate {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy   String   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?  @map("deleted_by")

  company  Company               @relation(fields: [companyId], references: [id])
  creator  User                  @relation("EvaluationTemplateCreator", fields: [createdBy], references: [id])
  updater  User                  @relation("EvaluationTemplateUpdater", fields: [updatedBy], references: [id])
  sections EvaluationSection[]
  cycles   EvaluationCycle[]

  @@index([companyId], map: "idx_eval_template_company")
  @@map("evaluation_template")
}

/**
 * Groups criteria into sections with a weight percentage.
 * e.g. Work Performance (40%), Attitude (30%), etc.
 */
model EvaluationSection {
  id          String   @id @default(uuid())
  templateId  String   @map("template_id")
  name        String
  nameZh      String?  @map("name_zh")
  description String?
  weight      Decimal  @db.Decimal(5, 2)  // percentage, e.g. 40.00
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy   String   @map("updated_by")

  template EvaluationTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator  User                @relation("EvaluationSectionCreator", fields: [createdBy], references: [id])
  updater  User                @relation("EvaluationSectionUpdater", fields: [updatedBy], references: [id])
  criteria EvaluationCriteria[]

  @@index([templateId], map: "idx_eval_section_template")
  @@map("evaluation_section")
}

/**
 * Individual scoring criterion within a section.
 */
model EvaluationCriteria {
  id          String   @id @default(uuid())
  sectionId   String   @map("section_id")
  name        String
  nameZh      String?  @map("name_zh")
  description String?
  weight      Decimal  @db.Decimal(5, 2)  // weight within section
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy   String   @map("updated_by")

  section  EvaluationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  creator  User              @relation("EvaluationCriteriaCreator", fields: [createdBy], references: [id])
  updater  User              @relation("EvaluationCriteriaUpdater", fields: [updatedBy], references: [id])
  scores   EvaluationScore[]

  @@index([sectionId], map: "idx_eval_criteria_section")
  @@map("evaluation_criteria")
}

/**
 * One evaluation cycle = one quarter.
 * e.g. Q1 2026 (Jan–Mar), evaluated in April.
 */
model EvaluationCycle {
  id           String                @id @default(uuid())
  companyId    String                @map("company_id")
  templateId   String                @map("template_id")
  quarter      Int                   // 1 | 2 | 3 | 4
  year         Int
  periodStart  DateTime              @map("period_start") @db.Date
  periodEnd    DateTime              @map("period_end") @db.Date
  evalStart    DateTime?             @map("eval_start") @db.Date  // when evaluation opens
  evalEnd      DateTime?             @map("eval_end") @db.Date    // when evaluation closes
  status       EvaluationCycleStatus @default(DRAFT)
  notes        String?
  createdAt    DateTime              @default(now()) @map("created_at")
  createdBy    String                @map("created_by")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")
  updatedBy    String                @map("updated_by")
  deletedAt    DateTime?             @map("deleted_at")
  deletedBy    String?               @map("deleted_by")

  company     Company              @relation(fields: [companyId], references: [id])
  template    EvaluationTemplate   @relation(fields: [templateId], references: [id])
  creator     User                 @relation("EvaluationCycleCreator", fields: [createdBy], references: [id])
  updater     User                 @relation("EvaluationCycleUpdater", fields: [updatedBy], references: [id])
  evaluations EmployeeEvaluation[]

  @@unique([companyId, quarter, year], map: "uq_eval_cycle_quarter_year")
  @@index([companyId], map: "idx_eval_cycle_company")
  @@map("evaluation_cycle")
}

/**
 * One evaluation per employee per cycle.
 * Links to EmployeeContract for contract renewal reference.
 */
model EmployeeEvaluation {
  id                  String           @id @default(uuid())
  companyId           String           @map("company_id")
  cycleId             String           @map("cycle_id")
  employeeId          String           @map("employee_id")
  contractId          String?          @map("contract_id")   // link to active contract
  teamLeadId          String?          @map("team_lead_id")  // local Ethiopian team lead
  disciplineLeadId    String?          @map("discipline_lead_id")
  status              EvaluationStatus @default(PENDING)

  // Consolidated final score (calculated by system after DL assessment)
  // Average of self + team lead + discipline lead scores
  finalScore          Decimal?         @map("final_score") @db.Decimal(5, 2)

  // Score after HR or DL adjustment (if disputed and adjusted)
  adjustedScore       Decimal?         @map("adjusted_score") @db.Decimal(5, 2)

  // Timestamps for auto-resolution (5-day deadlines)
  resultSharedAt      DateTime?        @map("result_shared_at")
  employeeRespondBy   DateTime?        @map("employee_respond_by")    // resultSharedAt + 5 days
  dlRespondBy         DateTime?        @map("dl_respond_by")          // disputedAt + 5 days
  dlAdjustedAt        DateTime?        @map("dl_adjusted_at")
  employeeAdjRespondBy DateTime?       @map("employee_adj_respond_by") // dlAdjustedAt + 5 days

  lockedAt            DateTime?        @map("locked_at")
  lockedBy            String?          @map("locked_by")
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  createdBy           String           @map("created_by")
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at")
  updatedBy           String           @map("updated_by")
  deletedAt           DateTime?        @map("deleted_at")
  deletedBy           String?          @map("deleted_by")

  company        Company              @relation(fields: [companyId], references: [id])
  cycle          EvaluationCycle      @relation(fields: [cycleId], references: [id])
  employee       User                 @relation("EvaluationEmployee", fields: [employeeId], references: [id])
  teamLead       User?                @relation("EvaluationTeamLead", fields: [teamLeadId], references: [id])
  disciplineLead User?                @relation("EvaluationDisciplineLead", fields: [disciplineLeadId], references: [id])
  contract       EmployeeContract?    @relation(fields: [contractId], references: [id])
  locker         User?                @relation("EvaluationLocker", fields: [lockedBy], references: [id])
  creator        User                 @relation("EmployeeEvaluationCreator", fields: [createdBy], references: [id])
  updater        User                 @relation("EmployeeEvaluationUpdater", fields: [updatedBy], references: [id])
  assessments    EvaluationAssessment[]
  disputes       EvaluationDispute[]

  @@unique([cycleId, employeeId], map: "uq_eval_cycle_employee")
  @@index([companyId], map: "idx_employee_eval_company")
  @@index([employeeId], map: "idx_employee_eval_employee")
  @@index([cycleId], map: "idx_employee_eval_cycle")
  @@map("employee_evaluation")
}

/**
 * One assessment per stage per evaluation.
 * SELF | TEAM_LEAD | DISCIPLINE_LEAD | HR
 */
model EvaluationAssessment {
  id             String          @id @default(uuid())
  evaluationId   String          @map("evaluation_id")
  stage          EvaluationStage
  assessorId     String          @map("assessor_id")
  sectionAvgJson Json?           @map("section_avg_json")  // cached section averages
  overallAvg     Decimal?        @map("overall_avg") @db.Decimal(5, 2)
  comment        String?         // overall comment from assessor
  submittedAt    DateTime?       @map("submitted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  createdBy      String          @map("created_by")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  updatedBy      String          @map("updated_by")

  evaluation EmployeeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  assessor   User               @relation("EvaluationAssessor", fields: [assessorId], references: [id])
  creator    User               @relation("EvaluationAssessmentCreator", fields: [createdBy], references: [id])
  updater    User               @relation("EvaluationAssessmentUpdater", fields: [updatedBy], references: [id])
  scores     EvaluationScore[]

  @@unique([evaluationId, stage], map: "uq_eval_assessment_stage")
  @@index([evaluationId], map: "idx_eval_assessment_evaluation")
  @@map("evaluation_assessment")
}

/**
 * Score per criterion per assessment.
 * score is NULL when N/A is selected.
 */
model EvaluationScore {
  id           String   @id @default(uuid())
  assessmentId String   @map("assessment_id")
  criteriaId   String   @map("criteria_id")
  score        Int?     // 1-5, NULL = N/A
  comment      String?  // optional per-criterion comment
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String   @map("created_by")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy    String   @map("updated_by")

  assessment EvaluationAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criteria   EvaluationCriteria   @relation(fields: [criteriaId], references: [id])
  creator    User                 @relation("EvaluationScoreCreator", fields: [createdBy], references: [id])
  updater    User                 @relation("EvaluationScoreUpdater", fields: [updatedBy], references: [id])

  @@unique([assessmentId, criteriaId], map: "uq_eval_score_assessment_criteria")
  @@index([assessmentId], map: "idx_eval_score_assessment")
  @@map("evaluation_score")
}

/**
 * Dispute record - created when employee disputes result.
 * Tracks the full dispute chain: employee → DL → HR.
 */
model EvaluationDispute {
  id             String                 @id @default(uuid())
  evaluationId   String                 @map("evaluation_id")
  initiatedBy    String                 @map("initiated_by")   // employee
  reason         String                 // employee's dispute reason
  stage          EvaluationDisputeStage @default(SUBMITTED_TO_DL)

  // DL response
  dlRespondedAt  DateTime?              @map("dl_responded_at")
  dlRespondedBy  String?                @map("dl_responded_by")
  dlDecision     String?                @map("dl_decision")    // UPHELD | ADJUSTED
  dlComment      String?                @map("dl_comment")
  dlAdjustedScore Decimal?             @map("dl_adjusted_score") @db.Decimal(5, 2)

  // Employee response to DL decision
  employeeAcknowledgedAt DateTime?      @map("employee_acknowledged_at")
  employeeDecision       String?        @map("employee_decision") // ACCEPTED | ESCALATED
  employeeEscalationReason String?      @map("employee_escalation_reason")

  // HR response (if escalated)
  hrRespondedAt  DateTime?              @map("hr_responded_at")
  hrRespondedBy  String?                @map("hr_responded_by")
  hrDecision     String?                @map("hr_decision")    // UPHELD | ADJUSTED
  hrComment      String?                @map("hr_comment")
  hrFinalScore   Decimal?               @map("hr_final_score") @db.Decimal(5, 2)

  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at")

  evaluation     EmployeeEvaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  initiator      User                   @relation("EvaluationDisputeInitiator", fields: [initiatedBy], references: [id])
  dlResponder    User?                  @relation("EvaluationDisputeDLResponder", fields: [dlRespondedBy], references: [id])
  hrResponder    User?                  @relation("EvaluationDisputeHRResponder", fields: [hrRespondedBy], references: [id])

  @@index([evaluationId], map: "idx_eval_dispute_evaluation")
  @@map("evaluation_dispute")
}


// ------------------- Payroll ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

enum PayrollRunStatus {
  DRAFT
  REVIEWED
  SUBMITTED
  APPROVED
  GM_APPROVED
  PAID
  CANCELLED
  /// Prior correction run superseded by a newer correction (audit trail only).
  SUPERSEDED

  @@map("payroll_run_status")
}

enum PayrollRunType {
  REGULAR
  CORRECTION

  @@map("payroll_run_type")
}

enum PayrollEntryFlag{
  NONE
  MISSING_ATTENDANCE
  MISSING_CONTRACT
  MISSING_OVERTIME_APPROVAL
  ZERO_SALARY
  MANUAL_OVERRIDE
  /// Leaving date falls in this month; final settlement handled outside the system.
  LEAVER_FINAL_MONTH
  /// Login disabled but employment period still open (kept on the roster).
  LOGIN_DISABLED_STILL_EMPLOYED
  /// Part of the month inside an InactivePeriod (days in the note).
  INACTIVE_IN_MONTH
  /// Latest contract ended with no new contract; paid on it while employment is open.
  CONTRACT_ENDED_NOT_RENEWED

  @@map("payroll_entry_flag")
}


model PayrollRun{
  id                      String                              @id @default(uuid())
  companyId               String                              @map("company_id")
  runNumber               String                              @map("run_number")
  month                   Int
  year                    Int
  type                    PayrollRunType                      @default(REGULAR)
  /// Correction runs point at the locked REGULAR run they adjust.
  originalRunId           String?                             @map("original_run_id")
  status                  PayrollRunStatus                    @default(DRAFT)
  totalEmployees          Int                                 @default(0) @map("total_employees")
  totalGross              Decimal                             @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalNetPay             Decimal                             @default(0) @map("total_net_pay") @db.Decimal(14, 2)
  totalNetBonus           Decimal                             @default(0) @map("total_net_bonus") @db.Decimal(14, 2)
  totalPensionEmp         Decimal                             @default(0) @map("total_pension_emp") @db.Decimal(14, 2)
  totalPensionEmr         Decimal                             @default(0) @map("total_pension_emr") @db.Decimal(14, 2)
  totalTax                Decimal                             @default(0) @map("total_tax") @db.Decimal(14, 2)
  taxableThreshold        Decimal                             @default(2200) @map("taxable_threshold") @db.Decimal(10, 2)
  bankLetterRefNo         String?                             @map("bank_letter_ref_no")
  notes                   String?
  attendanceSnapshotStale Boolean                             @default(false) @map("attendance_snapshot_stale")
  /// Approved/paid run whose month is affected by a later policy change - HR must review (never auto-recalculated).
  policyReviewRequired    Boolean                             @default(false) @map("policy_review_required")
  policyReviewNote        String?                             @map("policy_review_note")
  submittedAt             DateTime?                           @map("submitted_at")
  submittedBy             String?                             @map("submitted_by")
  approvedAt              DateTime?                           @map("approved_at")
  approvedBy              String?                             @map("approved_by")
  gmApprovedAt            DateTime?                           @map("gm_approved_at")
  gmApprovedBy            String?                             @map("gm_approved_by")
  paidAt                  DateTime?                           @map("paid_at")
  paidBy                  String?                             @map("paid_by")
  createdAt               DateTime                            @default(now())  @map("created_at")
  createdBy               String                              @map("created_by")
  updatedAt               DateTime                            @default(now()) @updatedAt @map("updated_at")
  updatedBy               String                              @map("updated_by")
  deletedAt               DateTime?                           @map("deleted_at")
  deletedBy               String?                             @map("deleted_by")


  company                 Company                             @relation(fields: [companyId], references: [id])
  creator                 User                                @relation("PayrollRunCreator", fields: [createdBy], references: [id])
  updater                 User                                @relation("PayrollRunUpdater", fields: [updatedBy], references: [id])
  submitter               User?                               @relation("PayrollRunSubmitter", fields: [submittedBy], references: [id])
  approver                User?                               @relation("PayrollRunApprover", fields: [approvedBy], references: [id])
  gmApprover              User?                               @relation("PayrollRunGMApprover", fields: [gmApprovedBy], references: [id])
  payer                   User?                               @relation("PayrollRunPayer", fields: [paidBy], references: [id])
  originalRun             PayrollRun?                         @relation("PayrollCorrections", fields: [originalRunId], references: [id])
  corrections             PayrollRun[]                        @relation("PayrollCorrections")
  entries                 PayrollEntry[]
  payslips                PayrollPayslip[]


  /// One active REGULAR run per company/month (enforced in SQL partial unique index).
  @@index([companyId, month, year], map: "idx_payroll_run_company_month_year")
  @@index([companyId], map: "idx_payroll_run_company")
  @@index([originalRunId], map: "idx_payroll_run_original")
  @@map("payroll_run")
}


model PayrollEntry {
  id                        String             @id @default(uuid())
  companyId                 String             @map("company_id")
  runId                     String             @map("run_id")
  employeeId                String             @map("employee_id")
  contractId                String?            @map("contract_id")
  attendanceRecordId        String?            @map("attendance_record_id")
  overtimeSheetId           String?            @map("overtime_sheet_id")


  // Attendance-based 
  scheduledDays            Decimal            @default(0) @map("scheduled_days") @db.Decimal(5, 2)
  presentDays              Decimal            @default(0) @map("present_days") @db.Decimal(5, 2)
  absentDays               Decimal            @default(0) @map("absent_days") @db.Decimal(5, 2)
  employedDays             Decimal            @default(0) @map("employed_days") @db.Decimal(5, 2)
  payrollDays              Decimal            @default(0) @map("payroll_days") @db.Decimal(5, 2)

  // Contract Values (snapshot at time of run)
  basicSalary              Decimal            @default(0) @map("basic_salary") @db.Decimal(14 , 2)
  transportAllowance       Decimal            @default(0) @map("transport_allowance") @db.Decimal(14, 2)
  monthlyBonus             Decimal            @default(0) @map("monthly_bonus") @db.Decimal(14 , 2)
  contractNetBonus         Decimal            @default(0) @map("contract_net_bonus") @db.Decimal(14, 2)


  // Earned salary 
  earnedSalary             Decimal             @default(0) @map("earned_salary") @db.Decimal(14,2)

  // Overtime (hours)

  normalOtHours            Decimal             @default(0) @map("normal_ot_hours") @db.Decimal(6,2)
  eveningOtHours           Decimal             @default(0) @map("evening_ot_hours") @db.Decimal(6,2)
  sundayOtHours            Decimal             @default(0) @map("sunday_ot_hours") @db.Decimal(6,2)
  holidayOtHours           Decimal             @default(0) @map("holiday_ot_hours") @db.Decimal(6,2)

  // Overtime pay amounts
  normalOtPay              Decimal             @default(0) @map("normal_ot_pay")  @db.Decimal(14, 2)
  eveningOtPay             Decimal             @default(0) @map("evening_ot_pay")  @db.Decimal(14, 2)
  sundayOtPay              Decimal             @default(0) @map("sunday_ot_pay")  @db.Decimal(14, 2)
  holidayOtPay             Decimal             @default(0) @map("holiday_ot_pay")  @db.Decimal(14, 2)
  totalOtPay               Decimal             @default(0) @map("total_ot_pay")    @db.Decimal(14, 2)

  // Transport 
  taxableTransport         Decimal             @default(0) @map("taxable_transport") @db.Decimal(14, 2)
  nonTaxableTransport      Decimal             @default(0) @map("non_taxable_transport") @db.Decimal(14, 2)

  // Totals 
  grossIncome              Decimal             @default(0) @map("gross_income") @db.Decimal(14, 2)
  taxableIncome            Decimal             @default(0) @map("taxable_income") @db.Decimal(14,2)

  // Deductions
  pensionEmployee          Decimal             @default(0) @map("pension_employee") @db.Decimal(14, 2)
  pensionEmployer          Decimal             @default(0) @map("pension_employer") @db.Decimal(14, 2)
  incomeTax                Decimal             @default(0) @map("income_tax") @db.Decimal(14, 2)
  totalDeductions          Decimal             @default(0) @map("total_deductions") @db.Decimal(14, 2)


  // Net Pay
  netPay                   Decimal             @default(0) @map("net_pay") @db.Decimal(14, 2)

  /// Correction-run only: net pay from the original locked run (0 if employee was absent then).
  originalAmount           Decimal?            @map("original_amount") @db.Decimal(14, 2)
  /// Correction-run only: recalculated net pay (same as netPay for correction entries).
  correctedAmount          Decimal?            @map("corrected_amount") @db.Decimal(14, 2)
  /// Correction-run only: correctedAmount - originalAmount (positive = owed, negative = recover).
  deltaAmount              Decimal?            @map("delta_amount") @db.Decimal(14, 2)

  // Final settlement (leaver final month, only when enabled in policy for that month)
  unusedLeavePayout        Decimal             @default(0) @map("unused_leave_payout") @db.Decimal(14, 2)
  severancePay             Decimal             @default(0) @map("severance_pay") @db.Decimal(14, 2)
  noticePay                Decimal             @default(0) @map("notice_pay") @db.Decimal(14, 2)

  // Bonus top-up (taxable, before tax)
  bonusTopUp               Decimal             @default(0) @map("bonus_top_up") @db.Decimal(14, 2)
  bonusTopUpReason         String?             @map("bonus_top_up_reason")

  // Net bonus top-up (after tax, not taxed)
  netTopUp                 Decimal             @default(0) @map("net_top_up") @db.Decimal(14, 2)
  netTopUpReason           String?             @map("net_top_up_reason")


  // Flags and overrides 
  flag                     PayrollEntryFlag   @default(NONE)
  flagNote                 String?            @map("flag_note")
  isManualOverride         Boolean            @default(false) @map("is_manual_override")
  overrideReason           String?            @map("override_reason")
  overrideBy               String?            @map("override_by")
  overrideAt               DateTime?          @map("override_at")


  // Bank details (snapshot at time of run )

  bankName                 String?            @map("bank_name")
  bankAccountNumber        String?            @map("bank_account_number")
  /// Snapshot of employee_type at run generation (payroll reporting category).
  employeeCategory         EmployeeType?      @map("employee_category")


  notes                    String?
  createdAt                DateTime           @default(now()) @map("created_at")
  createdBy                String             @map("created_by")
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at")
  updatedBy                String             @map("updated_by")


  company                  Company            @relation(fields: [companyId], references: [id])
  run                      PayrollRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee                 User               @relation("PayrollEntryEmployee", fields:[employeeId], references: [id] )
  contract                 EmployeeContract?  @relation(fields: [contractId], references: [id])
  attendanceRecord         AttendanceRecord?  @relation(fields: [attendanceRecordId], references: [id])
  overtimeSheet            OvertimeSheet?     @relation(fields: [overtimeSheetId], references: [id])
  overrider                User?              @relation("PayrollEntryOverrider", fields: [overrideBy], references: [id])
  creator                  User               @relation("PayrollEntryCreator", fields: [createdBy], references: [id])
  updater                  User               @relation("PayrollEntryUpdater", fields: [updatedBy], references: [id])
  salaryPeriods            PayrollSalaryPeriod[]
  payslip                  PayrollPayslip?
  audits                   PayrollEntryAudit[]


  @@unique([runId, employeeId], map: "uq_payroll_entry_run_employee")
  @@index([companyId], map:"idx_payroll_entry_company")
  @@index([runId], map: "idx_payroll_entry_run")
  @@index([employeeId], map: "idx_payroll_entry_employee")
  @@map("payroll_entry")
 }

 /// HR overrides of payroll entry figures. Served by HR-only endpoints; never shown to the employee.
 model PayrollEntryAudit {
  id              String        @id @default(uuid())
  payrollEntryId  String        @map("payroll_entry_id")
  field           String
  oldValue        String        @map("old_value")
  newValue        String        @map("new_value")
  reason          String?
  changedById     String        @map("changed_by_id")
  changedAt       DateTime      @default(now()) @map("changed_at")
  companyId       String        @map("company_id")

  payrollEntry    PayrollEntry  @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  changedBy       User          @relation("PayrollEntryAuditChangedBy", fields: [changedById], references: [id])
  company         Company       @relation(fields: [companyId], references: [id])

  @@index([payrollEntryId], map: "idx_payroll_entry_audit_entry")
  @@index([companyId], map: "idx_payroll_entry_audit_company")
  @@index([changedById], map: "idx_payroll_entry_audit_changed_by")
  @@map("payroll_entry_audit")
 }

 model PayrollSalaryPeriod{
  id            String           @id @default(uuid())
  entryId       String           @map("entry_id")
  contractId    String           @map("contract_id")
  periodStart   DateTime         @map("period_start") @db.Date
  periodEnd     DateTime         @map("period_end") @db.Date
  days          Decimal          @db.Decimal(5, 2)
  basicSalary   Decimal          @map("basic_salary") @db.Decimal(14, 2)
  earnedSalary  Decimal          @map("earned_salary") @db.Decimal(14, 2)

  // Overtime hours attributed to this contract period (from dated entries)
  normalOtHours   Decimal @default(0) @map("normal_ot_hours") @db.Decimal(6, 2)
  eveningOtHours  Decimal @default(0) @map("evening_ot_hours") @db.Decimal(6, 2)
  sundayOtHours   Decimal @default(0) @map("sunday_ot_hours") @db.Decimal(6, 2)
  holidayOtHours  Decimal @default(0) @map("holiday_ot_hours") @db.Decimal(6, 2)

  // Overtime pay priced from this period's basic ÷ 192 (holiday ÷ 196)
  normalOtPay   Decimal @default(0) @map("normal_ot_pay") @db.Decimal(14, 2)
  eveningOtPay  Decimal @default(0) @map("evening_ot_pay") @db.Decimal(14, 2)
  sundayOtPay   Decimal @default(0) @map("sunday_ot_pay") @db.Decimal(14, 2)
  holidayOtPay  Decimal @default(0) @map("holiday_ot_pay") @db.Decimal(14, 2)
  totalOtPay    Decimal @default(0) @map("total_ot_pay") @db.Decimal(14, 2)

  createdAt     DateTime         @default(now()) @map("created_at")
  createdBy     String           @map("created_by")
  updatedAt     DateTime         @default(now()) @updatedAt   @map("updated_at")
  updatedBy     String           @map("updated_by")

  entry         PayrollEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  contract      EmployeeContract  @relation(fields: [contractId], references: [id])
  creator       User             @relation("PayrollSalaryPeriodCreator", fields: [createdBy], references: [id])
  updater        User             @relation("PayrollSalaryPeriodUpdater", fields: [updatedBy], references: [id])


  @@index([entryId], map: "idx_payroll_salary_period_entry")
  @@map("payroll_salary_period") 
 }


 model PayrollPayslip {
  id            String              @id @default(uuid())
  companyId     String              @map("company_id")
  entryId       String              @unique @map("entry_id")
  employeeId    String              @map("employee_id")
  runId         String              @map("run_id")
  documentId    String?             @unique @map("document_id")
  generatedAt   DateTime?           @map("generated_at")
  generatedBy   String?             @map("generated_by")
  releasedAt    DateTime?           @map("released_at")
  releasedBy    String?             @map("released_by")
  downloadedAt  DateTime?           @map("downloaded_at")
  createdAt     DateTime?           @default(now())  @map("created_at")
  createdBy     String              @map("created_by")
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at")
  updatedBy     String              @map("updated_by")


  company      Company              @relation(fields: [companyId], references: [id])
  entry        PayrollEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  employee     User                 @relation("PayrollPayslipEmployee", fields: [employeeId], references: [id])
  run          PayrollRun           @relation(fields: [runId], references: [id])
  document     Document?            @relation(fields: [documentId], references: [id])
  generator    User?                @relation("PayrollPayslipGenerator", fields: [generatedBy], references: [id])
  releaser     User?                @relation("PayrollPayslipReleaser", fields: [releasedBy], references: [id])
  creator      User                 @relation("PayrollPayslipCreator", fields: [createdBy], references: [id])
  updater      User                 @relation("PayrollPayslipUpdater", fields: [updatedBy], references: [id])


  @@index([companyId], map: "idx_payroll_payslip_company")
  @@index([employeeId], map: "idx_payroll_payslip_employee")
  @@index([runId], map: "idx_payroll_payslip_run")
  @@map("payroll_payslip")
 }

// ─── Announcements ───────────────────────────────────────────────────────────

enum AnnouncementType {
  COMPANY
  SYSTEM_UPDATE
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AnnouncementScope {
  ALL
  DEPARTMENTS
  DISCIPLINES
  ROLES
  EMPLOYEES
}

/// Company news (HR) and system "What's new" posts (System Administrator).
/// Recipients are snapshotted on publish; see AnnouncementRecipient.
model Announcement {
  id                     String               @id @default(uuid())
  companyId              String               @map("company_id")
  number                 String
  type                   AnnouncementType     @default(COMPANY)
  title                  String
  titleZh                String?              @map("title_zh")
  /// Markdown; raw HTML is stripped on save and never rendered.
  body                   String
  bodyZh                 String?              @map("body_zh")
  priority               AnnouncementPriority @default(NORMAL)
  status                 AnnouncementStatus   @default(DRAFT)
  audienceScope          AnnouncementScope    @default(ALL) @map("audience_scope")
  departmentIds          String[]             @default([]) @map("department_ids")
  disciplineIds          String[]             @default([]) @map("discipline_ids")
  roleIds                String[]             @default([]) @map("role_ids")
  employeeIds            String[]             @default([]) @map("employee_ids")
  requireAcknowledgement Boolean              @default(false) @map("require_acknowledgement")
  sendEmail              Boolean              @default(false) @map("send_email")
  pinned                 Boolean              @default(false)
  publishAt              DateTime?            @map("publish_at")
  publishedAt            DateTime?            @map("published_at")
  expiresAt              DateTime?            @map("expires_at")
  /// Set when title/body change after publish ("Edited {date}").
  contentEditedAt        DateTime?            @map("content_edited_at")
  archivedAt             DateTime?            @map("archived_at")
  attachmentFolderId     String?              @map("attachment_folder_id")
  createdBy              String               @map("created_by")
  updatedBy              String               @map("updated_by")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")
  deletedBy              String?              @map("deleted_by")

  company          Company                 @relation(fields: [companyId], references: [id])
  creator          User                    @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  attachmentFolder DocumentFolder?         @relation(fields: [attachmentFolderId], references: [id])
  recipients       AnnouncementRecipient[]

  @@unique([companyId, number])
  @@index([companyId, status, deletedAt], map: "idx_announcement_company_status")
  @@index([companyId, type, status], map: "idx_announcement_company_type")
  @@index([status, publishAt], map: "idx_announcement_due")
  @@map("announcement")
}

model AnnouncementRecipient {
  id             String    @id @default(uuid())
  announcementId String    @map("announcement_id")
  userId         String    @map("user_id")
  readAt         DateTime? @map("read_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementRecipientUser", fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([userId, readAt], map: "idx_announcement_recipient_user_read")
  @@map("announcement_recipient")
}
