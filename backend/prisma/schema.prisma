  createdAt               DateTime                   @default(now()) @map("created_at")
  createdBy               String                     @map("created_by")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  updatedBy               String                     @map("updated_by")
  deletedAt               DateTime?                  @map("deleted_at")
  deletedBy               String?                    @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([companyId, changeNumber], map: "uq_project_change_request_company_number")
  @@index([companyId], map: "idx_project_change_request_company_id")
  @@index([companyId, deletedAt], map: "idx_project_change_request_company_deleted")
  @@index([projectId], map: "idx_project_change_request_project_id")
  @@index([status], map: "idx_project_change_request_status")
  @@map("project_change_request")
}

