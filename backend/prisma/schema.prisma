  IN_REVIEW
  APPROVED
  RETURNED
}

enum ProjectChangeRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CLOSED
}

enum ProjectChangeRequestSource {
  RFI
  SUBMITTAL_REVIEW
  EXTERNAL_TRIGGER
  MANUAL
}

enum ReviewSessionStatus {
  ACTIVE
  APPROVED
  RETURNED_FOR_REWORK
  CLOSED
  SUPERSEDED
}

enum ReviewSessionOutcome {
  PENDING
