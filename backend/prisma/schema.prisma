  businessTripPassengerTickets BusinessTripPassenger[]   @relation("BusinessTripPassengerTicket")
  expenseClaimItemReceipts    ExpenseClaimItem[]         @relation("ExpenseItemReceipt")
  vehicleRefuelingReceipts    VehicleRefueling[]         @relation("RefuelingReceipt")
  officialSealedDocuments     OfficialSeal[]             @relation("OfficialSealSealedDocument")
  projectSealedDocuments      ProjectSeal[]              @relation("ProjectSealSealedDocument")

