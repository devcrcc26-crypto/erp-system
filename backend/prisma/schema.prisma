}

// ─── Company & Settings ──────────────────────────────────────────────────────

model Company {
  id                String    @id @default(uuid())
  legalName         String    @map("legal_name")
  registrationNumber String?  @map("registration_number")
  vatNumber         String?   @map("vat_number")
  logoUrl           String?   @map("logo_url")
  baseCurrency      String    @default("USD") @map("base_currency")
  defaultLanguage   String    @default("en") @map("default_language")
  defaultTimezone   String    @default("UTC") @map("default_timezone")
  defaultDateFormat String    @default("DD/MM/YYYY") @map("default_date_format")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String    @map("created_by")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String    @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")

  settings         CompanySetting[]
  branches         Branch[]
  divisions        Division[]
  departments      Department[]
  disciplines      Discipline[]
  costCentres      CostCentre[]
  positions        Position[]
  financialYears   FinancialYear[]
  financialPeriods FinancialPeriod[]
  numberSeries     NumberSeries[]
  users            User[]
  roles            Role[]
  auditLogs        AuditLog[]
  notificationTemplates NotificationTemplate[]
  notifications    Notification[]
  documentFolders  DocumentFolder[]
  documents        Document[]
  reportDefinitions ReportDefinition[]
  dashboardWidgets DashboardWidget[]
  projects                Project[]
  taskDisciplines         TaskDiscipline[]
  engineeringDocuments    EngineeringDocument[]
  engineeringDocVersions  EngineeringDocumentVersion[]
  designPackages          DesignPackage[]
  designPackageItems      DesignPackageItem[]
  designPackageDependencies DesignPackageDependency[]
  workflowEventLogs       WorkflowEventLog[]
  reviewSessions          ReviewSession[]
  reviewContextSnapshots  ReviewContextSnapshot[]
  reviewComments          ReviewComment[]
  submittalItems          SubmittalItem[]
  submittalSiteReviews    SubmittalSiteReview[]
  submittalExternalApprovals SubmittalExternalApproval[]
  submittalExternalFeedback  SubmittalExternalFeedback[]
  externalReviewTriggers  ExternalReviewTrigger[]
  deliverables            Deliverable[]
  changeRequests          ProjectChangeRequest[]
  rfis                    Rfi[]
  issues                  Issue[]
  correspondence          Correspondence[]
  punchItems              PunchItem[]
  dailyLogs               DailyLog[]
  taskDisciplineReviews    TaskDisciplineReview[]
  designPackageAttachments DesignPackageAttachment[]
  reviewSessionAttachments ReviewSessionAttachment[]
  approvalCategories       ApprovalCategory[]
  approvalRequests         ApprovalRequest[]
  leaveRequests            LeaveRequest[]
  leaveBalances            LeaveBalance[]
  overtimeSheets           OvertimeSheet[]
  flightApplications       FlightApplication[]
  businessTrips            BusinessTrip[]
  exchangeRates            ExchangeRate[]
  employeePerDiemRates     EmployeePerDiemRate[]
  expenseClaims            ExpenseClaim[]
  perDiemRequests          PerDiemRequest[]
  purchaseRequests         PurchaseRequest[]
  materialRequisitions     MaterialRequisition[]
  consumablesRequisitions  ConsumablesRequisition[]
  companyVehicles          CompanyVehicle[]
  vehicleApplications      VehicleApplication[]
  vehicleRefuelings        VehicleRefueling[]
  inspectionRepairs        InspectionRepair[]
  officialSeals            OfficialSeal[]
  projectSeals             ProjectSeal[]
  EmployeeContracts        EmployeeContract[]
  companyAssets            CompanyAsset[]
  assetAssignments         AssetAssignment[]
  leavePolicies            LeavePolicy[]

  @@index([deletedAt], map: "idx_company_deleted_at")
  @@map("company")
}

model CompanySetting {
  id        String               @id @default(uuid())
  companyId String               @map("company_id")
  module    String
  key       String
  value     String
  dataType  CompanySettingDataType @default(STRING) @map("data_type")
  isPublic  Boolean              @default(false) @map("is_public")
  createdAt DateTime             @default(now()) @map("created_at")
  createdBy String               @map("created_by")
  updatedAt DateTime             @updatedAt @map("updated_at")
  updatedBy String               @map("updated_by")
  deletedAt DateTime?            @map("deleted_at")
  deletedBy String?              @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, module, key], map: "uq_company_setting_company_module_key")
  @@index([companyId], map: "idx_company_setting_company_id")
  @@index([companyId, deletedAt], map: "idx_company_setting_company_deleted")
  @@map("company_setting")
}

// ─── Organisation ────────────────────────────────────────────────────────────

model Branch {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  name         String
  address      String?
  city         String?
  country      String?
  phone        String?
  isHeadOffice Boolean   @default(false) @map("is_head_office")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]
  users       User[]
  projects    Project[]

  @@index([companyId], map: "idx_branch_company_id")
  @@index([companyId, deletedAt], map: "idx_branch_company_deleted")
  @@map("branch")
}

model Division {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  code        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String    @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]

  @@unique([companyId, code], map: "uq_division_company_code")
  @@index([companyId], map: "idx_division_company_id")
  @@index([companyId, deletedAt], map: "idx_division_company_deleted")
  @@map("division")
}

model Department {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  divisionId   String    @map("division_id")
  branchId     String    @map("branch_id")
  name         String
  nameZh       String?   @map("name_zh")
  code         String
  isActive     Boolean   @default(true) @map("is_active")
  leaderUserId String?   @map("leader_user_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  company     Company      @relation(fields: [companyId], references: [id])
  division    Division     @relation(fields: [divisionId], references: [id])
  branch      Branch       @relation(fields: [branchId], references: [id])
  leaderUser  User?        @relation("DepartmentLeader", fields: [leaderUserId], references: [id])
  costCentres CostCentre[]
  positions   Position[]
  users       User[]
  projects    Project[]

  @@unique([companyId, code], map: "uq_department_company_code")
  @@index([companyId], map: "idx_department_company_id")
  @@index([companyId, deletedAt], map: "idx_department_company_deleted")
  @@index([divisionId], map: "idx_department_division_id")
  @@index([branchId], map: "idx_department_branch_id")
  @@index([leaderUserId], map: "idx_department_leader_user_id")
  @@map("department")
}

/// Flat engineering discipline catalog (Highway, Structure, etc.) — not org HR department.
model Discipline {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  name      String
  nameZh    String?   @map("name_zh")
  isActive  Boolean   @default(true) @map("is_active")
  leaderId  String?   @map("leader_id")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String    @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  company         Company          @relation(fields: [companyId], references: [id])
  leader          User?            @relation("DisciplineLeader", fields: [leaderId], references: [id])
  taskDisciplines TaskDiscipline[]
  users           User[]           @relation("UserEngineeringDiscipline")

  @@unique([companyId, name], map: "uq_engineering_discipline_company_name")
  @@index([companyId], map: "idx_engineering_discipline_company_id")
  @@index([companyId, deletedAt], map: "idx_engineering_discipline_company_deleted")
  @@index([companyId, isActive], map: "idx_engineering_discipline_company_active")
  @@index([leaderId], map: "idx_discipline_leader")
  @@map("engineering_discipline")
}

model CostCentre {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  departmentId String         @map("department_id")
  name         String
  code         String
  type         CostCentreType @default(DIRECT)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  createdBy    String         @map("created_by")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  updatedBy    String         @map("updated_by")
  deletedAt    DateTime?      @map("deleted_at")
  deletedBy    String?        @map("deleted_by")

  company    Company    @relation(fields: [companyId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([companyId, code], map: "uq_cost_centre_company_code")
  @@index([companyId], map: "idx_cost_centre_company_id")
  @@index([companyId, deletedAt], map: "idx_cost_centre_company_deleted")
  @@index([departmentId], map: "idx_cost_centre_department_id")
  @@map("cost_centre")
}

model Position {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  departmentId String    @map("department_id")
  title        String
  grade        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  company    Company    @relation(fields: [companyId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  users      User[]

  @@index([companyId], map: "idx_position_company_id")
  @@index([companyId, deletedAt], map: "idx_position_company_deleted")
  @@index([departmentId], map: "idx_position_department_id")
  @@map("position")
}

// ─── Financial ───────────────────────────────────────────────────────────────

model FinancialYear {
  id        String              @id @default(uuid())
  companyId String              @map("company_id")
  name      String
  startDate DateTime            @map("start_date") @db.Date
  endDate   DateTime            @map("end_date") @db.Date
  status    FinancialYearStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")
  createdBy String              @map("created_by")
  updatedAt DateTime            @updatedAt @map("updated_at")
  updatedBy String              @map("updated_by")

  company  Company           @relation(fields: [companyId], references: [id])
  periods  FinancialPeriod[]

  @@index([companyId], map: "idx_financial_year_company_id")
  @@map("financial_year")
}

model FinancialPeriod {
  id                  String                @id @default(uuid())
  companyId           String                @map("company_id")
  financialYearId     String                @map("financial_year_id")
  name                String
  periodNumber        Int                   @map("period_number")
  startDate           DateTime              @map("start_date") @db.Date
  endDate             DateTime              @map("end_date") @db.Date
  status              FinancialPeriodStatus @default(OPEN)
  isAdjustmentPeriod  Boolean               @default(false) @map("is_adjustment_period")
  lockedAt            DateTime?             @map("locked_at")
  lockedBy            String?               @map("locked_by")
  closedAt            DateTime?             @map("closed_at")
  closedBy            String?               @map("closed_by")
  createdAt           DateTime              @default(now()) @map("created_at")
  createdBy           String                @map("created_by")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  updatedBy           String                @map("updated_by")

  company       Company       @relation(fields: [companyId], references: [id])
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@unique([financialYearId, periodNumber], map: "uq_financial_period_year_number")
  @@index([companyId], map: "idx_financial_period_company_id")
  @@index([financialYearId], map: "idx_financial_period_year_id")
  @@map("financial_period")
}

model NumberSeries {
  id             String                   @id @default(uuid())
  companyId      String                   @map("company_id")
  documentType   String                   @map("document_type")
  prefix         String                   @default("")
  suffix         String                   @default("")
  sequenceName   String                   @map("sequence_name")
  padding        Int                      @default(5)
  resetFrequency NumberSeriesResetFrequency @default(NEVER) @map("reset_frequency")
  createdAt      DateTime                 @default(now()) @map("created_at")
  createdBy      String                   @map("created_by")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  updatedBy      String                   @map("updated_by")
  deletedAt      DateTime?                @map("deleted_at")
  deletedBy      String?                  @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, documentType], map: "uq_number_series_company_doc_type")
  @@unique([sequenceName], map: "uq_number_series_sequence_name")
  @@index([companyId], map: "idx_number_series_company_id")
  @@index([companyId, deletedAt], map: "idx_number_series_company_deleted")
  @@map("number_series")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  companyId           String    @map("company_id")
  branchId            String?   @map("branch_id")
  departmentId            String?   @map("department_id")
  engineeringDisciplineId String?   @map("engineering_discipline_id")
  positionId          String?   @map("position_id")
  /// @deprecated Use engineeringDisciplineId — retained for migration/audit.
  discipline          UserDiscipline? @map("discipline")
  employeeId            String?         @unique @map("employee_id")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  middleName            String?         @map("middle_name")
  chineseName         String?   @map("chinese_name")
  email               String?
  pendingEmail        String?   @map("pending_email")
  phone               String?
  addressCountry        String?         @map("address_country")
  addressRegion         String?         @map("address_region")
  addressCity           String?         @map("address_city")
  addressSubcity        String?         @map("address_subcity")
  addressWoreda         String?         @map("address_woreda")
  addressHouseNumber    String?         @map("address_house_number")
  gender                Gender?
  dateOfBirth           DateTime?       @map("date_of_birth") @db.Date
  nationalId            String?         @map("national_id")
  nationality           Nationality?
  employeeType          EmployeeType?   @map("employee_type")
  educationLevel        EducationLevel? @map("education_level")
  fieldOfStudy          String?         @map("field_of_study")
  experienceStartDate   DateTime?       @map("experience_start_date") @db.Date
  emergencyContacts     Json?           @map("emergency_contacts")
  leavePolicyId         String?         @map("leave_policy_id")
  profileFolderId       String?         @map("profile_folder_id")
  photoDocumentId       String?         @map("photo_document_id")
  passwordHash        String    @map("password_hash")
  preferredLanguage   String?   @map("preferred_language")
  preferredTimezone   String?   @map("preferred_timezone")
  preferredDateFormat String?   @map("preferred_date_format")
  isActive            Boolean   @default(true) @map("is_active")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  lastLogin           DateTime? @map("last_login")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String    @map("created_by")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String    @map("updated_by")
  deletedAt           DateTime? @map("deleted_at")
  deletedBy           String?   @map("deleted_by")

  company                Company                 @relation(fields: [companyId], references: [id])
  branch                 Branch?                 @relation(fields: [branchId], references: [id])
  department             Department?             @relation(fields: [departmentId], references: [id])
  engineeringDiscipline  Discipline?             @relation("UserEngineeringDiscipline", fields: [engineeringDisciplineId], references: [id])
  position               Position?               @relation(fields: [positionId], references: [id])
  sessions               UserSession[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  userRoles              UserRole[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  documentVersions       DocumentVersion[]
  reportDefinitions      ReportDefinition[]
  ledDepartments         Department[]           @relation("DepartmentLeader")
  ledDisciplines         Discipline[]           @relation("DisciplineLeader")
  responsibleProjects    Project[]              @relation("ProjectResponsiblePerson")
  riskReviewsAsReviewer  RiskReview[]           @relation("RiskReviewer")
  riskMitigationsAssessed RiskMitigation[]      @relation("MitigationAssessor")
  projectTeamMemberships ProjectTeam[]
  dispatcherTasks        Task[]                 @relation("TaskDispatcher")
  supervisingChiefTasks  Task[]                 @relation("TaskSupervisingChief")
  assignedPersonTasks    Task[]                 @relation("TaskAssignedPerson")
  ownerDisciplines       TaskDiscipline[]       @relation("DisciplineOwner")
  raisedRfis             Rfi[]                  @relation("RfiRaisedBy")
  assignedRfis           Rfi[]                  @relation("RfiAssignedTo")
  rfiResponses           RfiResponse[]
  submittedSubmittals    Submittal[]            @relation("SubmittalSubmittedBy")
  reviewedSubmittals     Submittal[]            @relation("SubmittalReviewedBy")
  assignedSubmittals     Submittal[]            @relation("SubmittalAssignedTo")
  submittalReviews       SubmittalReview[]
  submittalSiteReviewsAsRep SubmittalSiteReview[] @relation("SubmittalSiteRep")
  submittalSiteReviewsReviewed SubmittalSiteReview[] @relation("SubmittalSiteReviewReviewedBy")
  submittalExternalApprovalsCreated SubmittalExternalApproval[] @relation("ApprovalCreator")
  submittalExternalFeedbackCreated  SubmittalExternalFeedback[] @relation("FeedbackCreator")
  drawingVersions        DrawingVersion[]
  dailyLogsAsEngineer    DailyLog[]
  supervisedLogs         DailyLog[]              @relation("DailyLogSupervisor")
  submittedDailyLogs     DailyLog[]              @relation("DailyLogSubmittedBy")
  approvedDailyLogs      DailyLog[]              @relation("DailyLogApprovedBy")
  organizedMeetings      Meeting[]
  meetingAgendaItems     MeetingAgendaItem[]
  meetingAttendees       MeetingAttendee[]
  meetingActionItems     ActionItem[]
  completedActionItems   ActionItem[]           @relation("ActionItemCompleter")
  correspondenceSent         Correspondence[] @relation("CorrespondenceSender")
  correspondenceReceived     Correspondence[] @relation("CorrespondenceRecipient")
  correspondenceMarkedSent   Correspondence[] @relation("CorrespondenceSentBy")
  correspondenceAcknowledged Correspondence[] @relation("CorrespondenceAck")
  ownedRisks             Risk[]
  raisedIssues           Issue[]                @relation("IssueRaisedBy")
  assignedIssues         Issue[]                @relation("IssueAssignedTo")
  resolvedIssues         Issue[]                @relation("IssueResolvedBy")
  reopenedIssues         Issue[]                @relation("IssueReopenedBy")
  issueResponses         IssueResponse[]
  raisedPunchItems       PunchItem[]            @relation("PunchRaisedBy")
  assignedPunchItems     PunchItem[]            @relation("PunchAssignedTo")
  verifiedPunchItems     PunchItem[]            @relation("PunchVerifiedBy")
  closedPunchItems       PunchItem[]            @relation("PunchClosedBy")
  verifiedChecklistItems CloseoutChecklistItem[]
  designerDisciplines      TaskDiscipline[] @relation("DisciplineDesigner")
  reviewerDisciplines      TaskDiscipline[] @relation("DisciplineReviewer")
  leadDisciplines          TaskDiscipline[] @relation("DisciplineLead")
  chiefDisciplines                  TaskDiscipline[]          @relation("DisciplineChief")
  instituteChiefDisciplines         TaskDiscipline[]          @relation("DisciplineInstituteChief")
  supportingDesignerDisciplines     TaskDiscipline[]          @relation("DisciplineSupportingDesigner")
  packageAttachments                DesignPackageAttachment[] @relation("PackageAttachmentAuthor")
  sessionAttachments                ReviewSessionAttachment[] @relation("SessionAttachmentAuthor")
  subtaskDesignerDesignPackages           DesignPackage[] @relation("SubtaskDesigner")
  subtaskSupportingDesignerPackages     DesignPackage[] @relation("SubtaskSupportingDesigner")
  subtaskDisciplineOwnerDesignPackages  DesignPackage[] @relation("SubtaskDisciplineOwner")
  subtaskReviewerDesignPackages         DesignPackage[] @relation("SubtaskReviewer")
  subtaskDisciplinaryLeaderPackages     DesignPackage[] @relation("SubtaskDisciplinaryLeader")
  subtaskDeptDeputyChiefPackages        DesignPackage[] @relation("SubtaskDeptDeputyChief")
  subtaskInstituteChiefDesignPackages   DesignPackage[] @relation("SubtaskInstituteChief")
  siteRepPackages                       DesignPackage[] @relation("PackageSiteRep")
  workflowEventLogs        WorkflowEventLog[]
  assignedReviewSessions   ReviewSession[]  @relation("ReviewSessionAssignee")
  authoredReviewComments   ReviewComment[] @relation("ReviewCommentAuthor")
  assignedReviewComments   ReviewComment[] @relation("ReviewCommentAssignee")
  capturedReviewSnapshots  ReviewContextSnapshot[] @relation("ReviewSnapshotCapturedBy")
  assignedChangeRequests   ProjectChangeRequest[] @relation("ChangeRequestAssignedTo")
  createdCategories        ApprovalCategory[]     @relation("CategoryCreator")
  updatedCategories        ApprovalCategory[]     @relation("CategoryUpdater")
