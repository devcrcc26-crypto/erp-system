  kmAtReturn                 Decimal?           @map("km_at_return") @db.Decimal(12, 2)
  purpose                    String
  hostOrganization           String?            @map("host_organization")
  hostContact                String?            @map("host_contact")
  expectedOutcomes           String?            @map("expected_outcomes")
  itinerary                  String?
