  projectedStatus        TaskDisciplineProjectedStatus @default(IN_PROGRESS) @map("projected_status")
  designerName         String?                      @map("designer_name")
  reviewerName         String?                      @map("reviewer_name")
  disciplinaryLeader   String?                      @map("disciplinary_leader")
  deptChiefEngineer    String?                      @map("dept_chief_engineer")
  disciplineOwnerName  String?                      @map("discipline_owner_name")
  designerUserId       String?                      @map("designer_user_id")
  ownerUserId          String?                      @map("owner_user_id")
  reviewerUserId       String?                      @map("reviewer_user_id")
  disciplineLeadUserId String?                      @map("discipline_lead_user_id")
  chiefUserId              String?                      @map("chief_user_id")
  instituteChiefUserId     String?                      @map("institute_chief_user_id")
  supportingDesignerUserId String?                      @map("supporting_designer_user_id")
  isClosed                 Boolean                      @default(false) @map("is_closed")
  closedAt                 DateTime?                    @map("closed_at")
  closedBy                 String?                      @map("closed_by")
  actualCompletionTime     DateTime?                    @map("actual_completion_time")
  deptReviewTime       DateTime?                    @map("dept_review_time")
  disciplineIndex        Int?                         @map("discipline_index")
  createdAt              DateTime                     @default(now()) @map("created_at")
  createdBy              String                       @map("created_by")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  updatedBy              String                       @map("updated_by")
  deletedAt              DateTime?                    @map("deleted_at")
  deletedBy              String?                      @map("deleted_by")

  task                  Task                  @relation(fields: [taskId], references: [id])
  company               Company               @relation(fields: [companyId], references: [id])
  discipline            Discipline?           @relation(fields: [disciplineId], references: [id])
  designerUser          User?                 @relation("DisciplineDesigner", fields: [designerUserId], references: [id])
  ownerUser             User?                 @relation("DisciplineOwner", fields: [ownerUserId], references: [id])
  reviewerUser          User?                 @relation("DisciplineReviewer", fields: [reviewerUserId], references: [id])
  disciplineLeadUser    User?                 @relation("DisciplineLead", fields: [disciplineLeadUserId], references: [id])
  chiefUser                 User?                 @relation("DisciplineChief", fields: [chiefUserId], references: [id])
  instituteChiefUser        User?                 @relation("DisciplineInstituteChief", fields: [instituteChiefUserId], references: [id])
  supportingDesignerUser    User?                 @relation("DisciplineSupportingDesigner", fields: [supportingDesignerUserId], references: [id])
  engineeringDocuments  EngineeringDocument[]
  designPackages        DesignPackage[]
  reviewSessions        ReviewSession[]
  disciplineReviews     TaskDisciplineReview[]
  deliverables          Deliverable[]
  rfis                  Rfi[]
  issues                Issue[]
  punchItems            PunchItem[]
  submittals            Submittal[]
  meetings              Meeting[]

  @@index([taskId], map: "idx_task_discipline_task_id")
  @@index([companyId], map: "idx_task_discipline_company_id")
  @@index([companyId, deletedAt], map: "idx_task_discipline_company_deleted")
  @@index([disciplineId], map: "idx_task_discipline_discipline_id")
  @@index([designerUserId], map: "idx_task_discipline_designer_user_id")
  @@index([ownerUserId], map: "idx_task_discipline_owner_user_id")
  @@index([reviewerUserId], map: "idx_task_discipline_reviewer_user_id")
  @@index([instituteChiefUserId], map: "idx_task_discipline_institute_chief_user_id")
  @@index([supportingDesignerUserId], map: "idx_task_discipline_supporting_designer_user_id")
  @@map("task_discipline")
}

model EngineeringDocument {
  id               String                  @id @default(uuid())
  companyId        String                  @map("company_id")
  taskDisciplineId String                  @map("task_discipline_id")
  documentType     EngineeringDocumentType @map("document_type")
  documentNumber   String                  @map("document_number")
  title            String
  metadata         Json                    @default("{}")
  createdAt        DateTime                @default(now()) @map("created_at")
  createdBy        String                  @map("created_by")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  updatedBy        String                  @map("updated_by")
  deletedAt        DateTime?               @map("deleted_at")
  deletedBy        String?                 @map("deleted_by")

  company        Company                      @relation(fields: [companyId], references: [id])
  taskDiscipline TaskDiscipline               @relation(fields: [taskDisciplineId], references: [id])
  versions       EngineeringDocumentVersion[]
  deliverables   Deliverable[]

  @@index([companyId], map: "idx_engineering_document_company_id")
  @@index([companyId, deletedAt], map: "idx_engineering_document_company_deleted")
  @@index([taskDisciplineId], map: "idx_engineering_document_task_discipline_id")
  @@index([taskDisciplineId, deletedAt], map: "idx_engineering_document_task_discipline_deleted")
  @@map("engineering_document")
}

model EngineeringDocumentVersion {
  id                    String    @id @default(uuid())
  companyId             String    @map("company_id")
  engineeringDocumentId String    @map("engineering_document_id")
  documentVersionId     String    @map("document_version_id")
  revisionLabel         String    @map("revision_label")
  status                EdvStatus @default(DRAFT)
  isCurrent             Boolean   @default(false) @map("is_current")
  createdAt             DateTime  @default(now()) @map("created_at")
  createdBy             String    @map("created_by")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  updatedBy             String    @map("updated_by")
  deletedAt             DateTime? @map("deleted_at")
  deletedBy             String?   @map("deleted_by")

  company             Company             @relation(fields: [companyId], references: [id])
  engineeringDocument EngineeringDocument @relation(fields: [engineeringDocumentId], references: [id])
  documentVersion     DocumentVersion     @relation(fields: [documentVersionId], references: [id])
  designPackageItems  DesignPackageItem[]
  reviewComments      ReviewComment[]
  reviewCommentDocuments ReviewCommentDocument[]

  @@unique([engineeringDocumentId, revisionLabel], map: "uq_edv_document_revision_label")
  @@index([companyId], map: "idx_engineering_document_version_company_id")
  @@index([companyId, deletedAt], map: "idx_engineering_document_version_company_deleted")
  @@index([engineeringDocumentId], map: "idx_engineering_document_version_document_id")
  @@index([engineeringDocumentId, deletedAt], map: "idx_engineering_document_version_document_deleted")
  @@index([engineeringDocumentId, isCurrent, deletedAt], map: "idx_engineering_document_version_document_current_deleted")
  @@index([documentVersionId], map: "idx_engineering_document_version_doc_version_id")
  @@index([status], map: "idx_engineering_document_version_status")
  @@map("engineering_document_version")
}

model DesignPackage {
  id                String                       @id @default(uuid())
  companyId         String                       @map("company_id")
  taskDisciplineId  String                       @map("task_discipline_id")
  packageCode       String                       @map("package_code")
  subtaskIndex      Int?                         @map("subtask_index")
  subtaskId         String?                      @map("subtask_id")
  name              String
  nameZh            String?                      @map("name_zh")
  mainWorkContent   String?                      @map("main_work_content")
  plannedStartDate  DateTime?                    @map("planned_start_date") @db.Date
  plannedFinishDate DateTime?                    @map("planned_finish_date") @db.Date
  actualWorkDays    Int?                         @map("actual_work_days")
  urgencyLevel      UrgencyLevel?                @map("urgency_level")
  reviewLevel       ApprovalLevel?               @map("review_level")
  projectedStatus   DesignPackageProjectedStatus @default(IN_PROGRESS) @map("projected_status")
  projectionPending Boolean                      @default(false) @map("projection_pending")
  submittedAt       DateTime?                    @map("submitted_at")
  approvedAt        DateTime?                    @map("approved_at")
  requiredTiers     ReviewTier[]                 @map("required_tiers")
  designerUserId             String?                      @map("designer_user_id")
  reviewerUserId             String?                      @map("reviewer_user_id")
  disciplinaryLeaderUserId   String?                      @map("disciplinary_leader_user_id")
  deptDeputyChiefUserId      String?                      @map("dept_deputy_chief_user_id")
  instituteChiefUserId       String?                      @map("institute_chief_user_id")
  instituteChiefName         String?                      @map("institute_chief_name")
  disciplineOwnerUserId      String?                      @map("discipline_owner_user_id")
  supportingDesignerUserId   String?                      @map("supporting_designer_user_id")
  siteRepresentativeUserId   String?                      @map("site_representative_user_id")
  siteRepType                SiteRepType?                 @default(EXTERNAL) @map("site_rep_type")
  siteRepName                String?                      @map("site_rep_name")
  siteRepEmail               String?                      @map("site_rep_email")
  siteRepPhone               String?                      @map("site_rep_phone")
  siteRepCompany             String?                      @map("site_rep_company")
  consultantName             String?                      @map("consultant_name")
  consultantTitle            String?                      @map("consultant_title")
  consultantEmail            String?                      @map("consultant_email")
  consultantPhone            String?                      @map("consultant_phone")
  consultantCompany          String?                      @map("consultant_company")
  briefText         String?                      @map("brief_text")
  sourceEntityType  String?                      @map("source_entity_type")
  sourceEntityId    String?                      @map("source_entity_id")
  packageStatus     DesignPackageStatus          @default(OPEN) @map("package_status")
  packageClosedAt   DateTime?                    @map("package_closed_at")
  packageClosedBy   String?                      @map("package_closed_by")
  createdAt         DateTime                     @default(now()) @map("created_at")
  createdBy         String                       @map("created_by")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  updatedBy         String                       @map("updated_by")
  deletedAt         DateTime?                    @map("deleted_at")
  deletedBy         String?                      @map("deleted_by")

  company        Company                   @relation(fields: [companyId], references: [id])
  taskDiscipline TaskDiscipline            @relation(fields: [taskDisciplineId], references: [id])
  designerUser           User? @relation("SubtaskDesigner", fields: [designerUserId], references: [id])
  reviewerUser           User? @relation("SubtaskReviewer", fields: [reviewerUserId], references: [id], map: "design_package_package_reviewer_user_id_fkey")
  disciplinaryLeaderUser User? @relation("SubtaskDisciplinaryLeader", fields: [disciplinaryLeaderUserId], references: [id], map: "design_package_package_discipline_lead_user_id_fkey")
  deptDeputyChiefUser    User? @relation("SubtaskDeptDeputyChief", fields: [deptDeputyChiefUserId], references: [id], map: "design_package_package_chief_user_id_fkey")
  instituteChiefUser     User? @relation("SubtaskInstituteChief", fields: [instituteChiefUserId], references: [id], map: "design_package_package_institute_chief_user_id_fkey")
  disciplineOwnerUser    User? @relation("SubtaskDisciplineOwner", fields: [disciplineOwnerUserId], references: [id], map: "design_package_package_owner_user_id_fkey")
  supportingDesignerUser User? @relation("SubtaskSupportingDesigner", fields: [supportingDesignerUserId], references: [id])
  siteRepresentative     User? @relation("PackageSiteRep", fields: [siteRepresentativeUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items          DesignPackageItem[]
  dependencies   DesignPackageDependency[] @relation("DependentPackage")
  dependedOnBy   DesignPackageDependency[] @relation("PrerequisitePackage")
  reviewSessions ReviewSession[]
  submittalItems SubmittalItem[]
  deliverables   Deliverable[]
  attachments    DesignPackageAttachment[]
  linkedRfis                 Rfi[]                    @relation("RfiLinkedDesignPackage")
  linkedIssues               Issue[]                  @relation("IssueLinkedDesignPackage")
  linkedPunchItems           PunchItem[]              @relation("PunchPackage")
  linkedChangeRequests       ProjectChangeRequest[]   @relation("ChangeRequestLinkedDesignPackage")
  linkedExternalReviewTriggers ExternalReviewTrigger[] @relation("TriggerLinkedDesignPackage")
  meetings                    Meeting[]
  actionItems                 ActionItem[]

  @@index([companyId], map: "idx_design_package_company_id")
  @@index([companyId, deletedAt], map: "idx_design_package_company_deleted")
  @@index([taskDisciplineId], map: "idx_design_package_task_discipline_id")
  @@index([designerUserId], map: "idx_design_package_designer_user_id")
  @@index([supportingDesignerUserId], map: "idx_design_package_supporting_designer_user_id")
  @@index([siteRepresentativeUserId], map: "idx_design_package_site_representative_user_id")
  @@index([deptDeputyChiefUserId], map: "idx_design_package_package_chief_user_id")
  @@index([disciplinaryLeaderUserId], map: "idx_design_package_package_discipline_lead_user_id")
  @@index([instituteChiefUserId], map: "idx_design_package_package_institute_chief_user_id")
  @@index([disciplineOwnerUserId], map: "idx_design_package_package_owner_user_id")
  @@index([reviewerUserId], map: "idx_design_package_package_reviewer_user_id")
  @@map("design_package")
}

model DesignPackageItem {
  id                           String   @id @default(uuid())
  companyId                    String   @map("company_id")
  designPackageId              String   @map("design_package_id")
  engineeringDocumentVersionId String   @map("engineering_document_version_id")
  sortOrder                    Int      @default(0) @map("sort_order")
  createdAt                    DateTime @default(now()) @map("created_at")
  createdBy                    String   @map("created_by")

  company                    Company                    @relation(fields: [companyId], references: [id])
  designPackage              DesignPackage              @relation(fields: [designPackageId], references: [id])
  engineeringDocumentVersion EngineeringDocumentVersion @relation(fields: [engineeringDocumentVersionId], references: [id])

  @@unique([designPackageId, engineeringDocumentVersionId], map: "uq_design_package_item_package_edv")
  @@index([companyId], map: "idx_design_package_item_company_id")
  @@index([designPackageId], map: "idx_design_package_item_package_id")
  @@index([engineeringDocumentVersionId], map: "idx_design_package_item_edv_id")
  @@map("design_package_item")
}

model DesignPackageDependency {
  id                 String                      @id @default(uuid())
  companyId          String                      @map("company_id")
  designPackageId    String                      @map("design_package_id")
  dependsOnPackageId String                      @map("depends_on_package_id")
  dependencyType     DesignPackageDependencyType @map("dependency_type")
  createdAt          DateTime                    @default(now()) @map("created_at")
  createdBy          String                      @map("created_by")

  company          Company       @relation(fields: [companyId], references: [id])
  designPackage    DesignPackage @relation("DependentPackage", fields: [designPackageId], references: [id])
  dependsOnPackage DesignPackage @relation("PrerequisitePackage", fields: [dependsOnPackageId], references: [id])

  @@unique([designPackageId, dependsOnPackageId], map: "uq_design_package_dependency")
  @@index([companyId], map: "idx_design_package_dependency_company_id")
  @@index([designPackageId], map: "idx_design_package_dependency_package_id")
  @@index([dependsOnPackageId], map: "idx_design_package_dependency_depends_on_id")
  @@map("design_package_dependency")
}

model WorkflowEventLog {
