  HIGHWAY
  HYDROLOGY
  STRUCTURE_ROAD
  GEOLOGICAL
  PAVEMENT_MATERIAL
  SURVEY
  ARCHITECTURE
  INTERIOR_DESIGN
  LANDSCAPE_DESIGN
  STRUCTURE_BUILDING
  SANITARY
  ELECTRICAL_ICT
  MECHANICAL
}

enum AuditLogSource {
  USER_ACTION
  SYSTEM_JOB
  API_INTEGRATION
  MIGRATION
}

enum FinancialYearStatus {
  OPEN
  CLOSED
}

enum FinancialPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum FolderContextType {
  SYSTEM
  COMPANY
  PROJECT
  DEPARTMENT
  USER
  TASK_DISCIPLINE
  RFI
  ISSUE
  SUBMITTAL
  DAILY_LOG
  MEETING
  CORRESPONDENCE
  RISK
  PUNCH_ITEM
  CHANGE_REQUEST
  APPROVAL
  LEAVE
  OVERTIME
  FLIGHT
  BUSINESS_TRIP
  EXPENSE_CLAIM
  PER_DIEM
  PURCHASE_REQUEST
  MATERIAL_REQUISITION
  CONSUMABLES_REQUISITION
  VEHICLE_APPLICATION
  VEHICLE_REFUELING
  INSPECTION_REPAIR
  OFFICIAL_SEAL
  PROJECT_SEAL
  EMPLOYEE_CONTRACT
  EMPLOYEE_PROFILE
}

enum Nationality {
  ETHIOPIAN
  CHINESE
}

enum EmployeeType {
  PERMANENT
  CONTRACT
  TEMPORARY
}

enum Gender {
  MALE
  FEMALE
}

enum EducationLevel {
  PHD
  MSC
  BSC
  DIPLOMA
  CERTIFICATE
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
