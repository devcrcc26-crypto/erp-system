/// Effective-dated HR policy value. Versions are append-only; the version in force for a
/// month is the latest effectiveFrom ≤ that month (ties: latest createdAt). Missing → code default.
model PolicySetting {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  key           String
  value         Json
  /// Always the 1st of a month.
  effectiveFrom DateTime @map("effective_from") @db.Date
  reason        String
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([companyId, key, effectiveFrom], map: "idx_policy_setting_company_key_from")
  @@map("policy_setting")
}

/// Suspension / long leave / other inactive spell inside an employment period.
/// toDate = last inactive day (null = open). Pay and login follow the inactivePaid /
/// inactiveCanLogin policies as of each day's month.
model InactivePeriod {
  id                      String       @id @default(uuid())
  companyId               String       @map("company_id")
  userId                  String       @map("user_id")
  type                    InactiveType
  fromDate                DateTime     @map("from_date") @db.Date
  toDate                  DateTime?    @map("to_date") @db.Date
  reason                  String
  createdById             String       @map("created_by_id")
  createdAt               DateTime     @default(now()) @map("created_at")
  endedById               String?      @map("ended_by_id")
  endedAt                 DateTime?    @map("ended_at")
  /// True when this period (action or daily job) turned login off; reactivation turns it back on.
  loginDisabledByInactive Boolean      @default(false) @map("login_disabled_by_inactive")

  user User @relation("InactivePeriodEmployee", fields: [userId], references: [id])

  @@index([userId], map: "idx_inactive_period_user")
  @@index([companyId, fromDate], map: "idx_inactive_period_company_from")
  @@map("inactive_period")
}

/// One row per employment stint; the row with endDate null is the current employment.
/// endDate = last working day. User.employmentDate mirrors startDate of the current period.
model EmploymentPeriod {
  id               String          @id @default(uuid())
  companyId        String          @map("company_id")
  userId           String          @map("user_id")
  startDate        DateTime        @map("start_date") @db.Date
  endDate          DateTime?       @map("end_date") @db.Date
  separationType   SeparationType? @map("separation_type")
  separationReason String?         @map("separation_reason")
  separatedById    String?         @map("separated_by_id")
  separatedAt      DateTime?       @map("separated_at")
  /// Snapshot so a separation can be cancelled: the contract it shortened and its prior end date.
  separationContractId          String?   @map("separation_contract_id")
  separationContractPrevEndDate DateTime? @map("separation_contract_prev_end_date") @db.Date
  /// True once the separation (or daily job) turned login off; cancel turns it back on.
  loginDisabledBySeparation     Boolean   @default(false) @map("login_disabled_by_separation")
  createdAt        DateTime        @default(now()) @map("created_at")
  createdBy        String?         @map("created_by")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")

  user        User  @relation("EmploymentPeriodEmployee", fields: [userId], references: [id])
  separatedBy User? @relation("EmploymentPeriodSeparatedBy", fields: [separatedById], references: [id])

  @@index([userId], map: "idx_employment_period_user")
  @@index([companyId, endDate], map: "idx_employment_period_company_end")
  @@map("employment_period")
}

