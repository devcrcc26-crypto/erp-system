enum EmployeeContractStatus{
    DRAFT
    ACTIVE
    SUPERSEDED
    TERMINATED
    EXPIRED
}

enum EmployeeContractType{
    FIXED_TERM
    OPEN_ENDED
    PROBATION
    RENEWAL
}


model EmployeeContract{
  id                        String                        @id @default(uuid())
  companyId                 String                        @map("company_id")
  contractNumber            String                        @map("contract_number")
  employeeId                String                        @map("employee_id")
  contractType              EmployeeContractType          @default(FIXED_TERM) @map("contract_type")
  status                    EmployeeContractStatus        @default(ACTIVE)
  signedAt                  DateTime                      @map("signed_at") @db.Date
  startDate                 DateTime                      @map("start_date") @db.Date
  endDate                   DateTime?                     @map("end_date") @db.Date
  terminatedAt              DateTime?                     @map("terminated_at") @db.Date
  terminationReason         String?                       @map("termination_reason")
  notes                     String?
  basicSalary               Decimal?                      @map("basic_salary") @db.Decimal(14, 2)
  transportationAllowance   Decimal?                      @map("transportation_allowance") @db.Decimal(14, 2)
  monthlyBonus              Decimal?                      @map("monthly_bonus") @db.Decimal(14, 2)
  netSalary                 Decimal?                      @map("net_salary") @db.Decimal(14, 2)
  probationEndDate          DateTime?                     @map("probation_end_date") @db.Date
  governedBy                String?                       @map("governed_by")
  lastWarnedAt              DateTime?                     @map("last_warned_at")
  attachmentFolderId       String?                        @map("attachment_folder_id")
  createdAt                 DateTime                      @default(now()) @map("created_at")
  createdBy                 String                        @map("created_by")
  updatedAt                 DateTime                      @updatedAt @map("updated_at")
  updatedBy                 String                        @map("updated_by")
  deletedAt                 DateTime?                     @map("deleted_at")
  deletedBy                 String?                       @map("deleted_by")


  company                   Company                       @relation(fields: [companyId], references: [id])
  employee                  User                          @relation("EmployeeContractEmployee", fields: [employeeId], references: [id])
  creator                   User                          @relation("EmployeeContractCreator", fields: [createdBy], references: [id])
  attachmentFolder          DocumentFolder?               @relation(fields: [attachmentFolderId], references: [id])

  @@unique([companyId, contractNumber], map: "uq_employee_contract_company_number")
  @@index([companyId], map:"idx_employee_contract_company")
  @@index([companyId, deletedAt], map: "idx_employee_contract_company_deleted")
  @@index([employeeId], map: "idx_employee_contract_employee")
  @@index([status],map: "idx_employee_contract_status")
  @@index([attachmentFolderId], map: "idx_employee_contract_attachment_folder")
  @@index([companyId, status, endDate], map:"idx_employee_contract_expiring")
  
  @@map("employee_contract")
}

enum AssetStatus {
    AVAILABLE
    REPAIRING
    DISPOSED
    IN_USE
}


model CompanyAsset {
    id            String            @id @default(uuid())
    companyId     String            @map("company_id")
    serialNumber  String            @map("serial_number")
    brand         String            @map("brand")
    model         String            @map("model")
    year          Int               @map("year")
    color         String            @map("color")
    type          String         @map("type")
    status        AssetStatus       @map("status")
    description   String?           @map("description")
    assetCode          String?   @map("asset_code")
    cardNumber         String?   @map("card_number")
    assetName          String?   @map("asset_name")
    specifications     String?   @map("specifications")
    assetCategory      String?   @map("asset_category")
    startUseDate       DateTime? @map("start_use_date") @db.Date
    usefulLifeMonths   Int?      @map("useful_life_months")
    originalValue      Decimal?  @map("original_value") @db.Decimal(14, 2)
    managingDepartment String?   @map("managing_department")
    storageLocation    String?   @map("storage_location")
    projectCode        String?   @map("project_code")
    createdAt     DateTime          @default(now()) @map("created_at")
    updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")
    updatedBy     String            @map("updated_by")
    createdBy     String            @map("created_by")
    deletedAt     DateTime?         @map("deleted_at")
    deletedBy     String?            @map("deleted_by")
    photoDocumentId String?           @map("photo_document_id")

    company       Company  @relation(fields: [companyId], references: [id])
    creator       User     @relation("AssetCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
    updater       User     @relation("AssetUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
    photoDocument Document? @relation("CompanyAssetPhotoDocument", fields: [photoDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    assetAssignments AssetAssignment[] @relation("AssetAssignment")
    inspectionRepairs InspectionRepair[]


    @@unique([companyId, serialNumber])
    @@index([companyId], map: "idx_company_asset")
    @@index([companyId, assetCode], map: "idx_company_asset_code")
    @@index([companyId, deletedAt], map: "idx_company_asset_deleted")
    @@index([photoDocumentId], map: "idx_company_asset_photo_document")
    @@index([status], map: "idx_company_asset_status")
    @@map("company_asset")

}


model AssetAssignment {
    id            String            @id @default(uuid())
    companyId     String            @map("company_id")
    assetId       String            @map("asset_id")
    userId        String            @map("user_id")
    assignedAt    DateTime          @default(now()) @map("assigned_at")
    returnedTo    String?           @map("returned_to")
    notes         String?           @map("notes")
    returnedById    String?           @map("returned_by_id")
    returnedAt    DateTime?         @map("returned_at")
    returnedNotes String?           @map("returned_notes")
    issuedById      String            @map("issued_by_id")
    createdBy     String            @map("created_by")
    updatedBy     String            @map("updated_by")
    createdAt     DateTime @default(now()) @map("created_at")
    updatedAt     DateTime @updatedAt @map("updated_at")
    deletedAt     DateTime? @map("deleted_at")
    deletedBy     String?   @map("deleted_by")



    company           Company       @relation(fields: [companyId], references: [id])
    asset             CompanyAsset  @relation("AssetAssignment", fields: [assetId], references: [id])
    employee          User          @relation("AssetAssignmentEmployee", fields: [userId], references: [id])
    issuedBy          User          @relation("AssetAssignmentIssuedBy", fields: [issuedById], references: [id])
    returnedBy        User?         @relation("AssetAssignmentReturnedBy", fields: [returnedById], references: [id])
    creator           User          @relation("AssetAssignmentCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
    updater           User          @relation("AssetAssignmentUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@index([companyId, assetId], map: "idx_company_asset_assignment_asset")
    @@index([companyId, userId], map: "idx_company_asset_assignment_user")
    @@index([companyId, issuedById], map: "idx_company_asset_assignment_issued_by")
    @@index([companyId, returnedById], map: "idx_company_asset_assignment_returned_by")
    @@index([companyId, deletedAt], map: "idx_company_asset_assignment_deleted")
    @@map("asset_assignment")
}