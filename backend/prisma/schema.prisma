  PENDING
  APPROVED
  CONDITIONALLY_APPROVED
  REJECTED
  SKIPPED
  RETURNED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  PATERNITY
  EMERGENCY
  COMPASSIONATE
  STUDY
  EXAM
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
