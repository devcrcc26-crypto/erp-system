model Project {
  id                String        @id @default(uuid())
  companyId         String        @map("company_id")
  clientCompanyId   String?       @map("client_company_id")
  branchId          String?       @map("branch_id")
  projectCode       String        @map("project_code")
  name              String
  nameZh            String?       @map("name_zh")
  location          String?
  projectType       ProjectType?  @map("project_type")
  railwayLengthKm   Float?        @map("railway_length_km")
  urbanRailLengthKm Float?        @map("urban_rail_length_km")
  roadLengthKm      Float?        @map("road_length_km")
  grossFloorAreaM2  Float?        @map("gross_floor_area_m2")
  contractType      ProjectContractType @default(NO_ASSIGNMENT) @map("contract_type")
  status            ProjectStatus @default(NOT_STARTED)
  startDate         DateTime?     @map("start_date") @db.Date
  plannedFinishDate DateTime?     @map("planned_finish_date") @db.Date
  actualFinishDate  DateTime?     @map("actual_finish_date") @db.Date
  budget            Decimal?      @db.Decimal(18, 2)
  currency                String?
  client                  String?
  /// @deprecated Use departmentId FK - retained for migration/audit.
  responsibleDepartment   ProjectResponsibleDepartment @default(MUNICIPAL_TRANSPORTATION_DEPARTMENT) @map("responsible_department")
  departmentId            String?       @map("department_id")
  designProperties        ProjectDesignProperties      @default(PRELIMINARY) @map("design_properties")
  designStage             ProjectDesignStage           @default(TENDER) @map("design_stage")
  responsiblePersonId     String?       @map("responsible_person_id")
  description             String?
  overallProgressPct      Int           @default(0) @map("overall_progress_pct")
  isOutsourced            Boolean       @default(false) @map("is_outsourced")
  createdAt         DateTime      @default(now()) @map("created_at")
  createdBy         String        @map("created_by")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  updatedBy         String        @map("updated_by")
  deletedAt         DateTime?     @map("deleted_at")
  deletedBy         String?       @map("deleted_by")

  company               Company     @relation(fields: [companyId], references: [id])
  branch                Branch?     @relation(fields: [branchId], references: [id])
  department            Department? @relation(fields: [departmentId], references: [id])
  responsiblePerson     User?       @relation("ProjectResponsiblePerson", fields: [responsiblePersonId], references: [id])
  teamMembers    ProjectTeam[]
  milestones     Milestone[]
  tasks          Task[]
  rfis           Rfi[]
  submittals     Submittal[]
  externalReviewTriggers ExternalReviewTrigger[]
  deliverables   Deliverable[]
  changeRequests ProjectChangeRequest[]
  drawings       Drawing[]
  dailyLogs      DailyLog[]
  meetings       Meeting[]
  correspondence Correspondence[]
  risks          Risk[]
  issues         Issue[]
  punchItems     PunchItem[]
  closeout       Closeout?
  materialRequisitions MaterialRequisition[]
  vehicleApplications  VehicleApplication[]
  siteAssignments      SiteAssignment[]

  @@unique([companyId, projectCode], map: "uq_project_company_code")
  @@index([companyId], map: "idx_project_company_id")
  @@index([companyId, deletedAt], map: "idx_project_company_deleted")
  @@index([status], map: "idx_project_status")
  @@index([responsibleDepartment], map: "idx_project_responsible_department")
  @@index([departmentId], map: "idx_project_department_id")
  @@index([responsiblePersonId], map: "idx_project_responsible_person_id")
  @@map("project")
}

model ProjectTeam {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  userId         String    @map("user_id")
  roleOnProject  String?   @map("role_on_project")
  visibleModules String[]  @default([]) @map("visible_modules")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String    @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId], map: "idx_project_team_project_id")
  @@index([userId], map: "idx_project_team_user_id")
  @@index([projectId, deletedAt], map: "idx_project_team_project_deleted")
  @@index([deletedAt], map: "idx_project_team_deleted_at")
  @@unique([projectId, userId], name: "project_team_member_unique")
  @@map("project_team")
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  name        String
  plannedDate DateTime? @map("planned_date") @db.Date
  actualDate  DateTime? @map("actual_date") @db.Date
  status      MilestoneStatus @default(PLANNED)
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String    @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]

  @@index([projectId], map: "idx_milestone_project_id")
  @@index([projectId, deletedAt], map: "idx_milestone_project_deleted")
  @@map("milestone")
}

model Task {
  id           String     @id @default(uuid())
  projectId    String     @map("project_id")
  milestoneId  String?    @map("milestone_id")
  parentTaskId         String? @map("parent_task_id")
  dispatcherUserId         String? @map("dispatcher_user_id")
  supervisingChiefUserId   String? @map("supervising_chief_user_id")
  assignedPersonUserId     String? @map("assigned_person_user_id")
  taskIdCode               String  @map("task_id_code")
  overseasTaskNumber       String? @map("overseas_task_number")
  name         String
  nameZh       String? @map("name_zh")
  description  String?
  startDate    DateTime?  @map("start_date") @db.Date
  finishDate   DateTime?  @map("finish_date") @db.Date
  durationDays Int?       @map("duration_days")
  progressPct  Int        @default(0) @map("progress_pct")
  status                TaskStatus        @default(NOT_STARTED)
  isCritical            Boolean           @default(false) @map("is_critical")
  commissionMode        CommissionMode?   @map("commission_mode")
  /// @deprecated Use commissionMode - retained for migration/audit.
  commissioningMethod   String?           @map("commissioning_method")
  requiresArchiving     Boolean           @default(false) @map("requires_archiving")
  taskAttributes        TaskAttributes?   @map("task_attributes")
  onSiteReceivingTime   DateTime?         @map("on_site_receiving_time")
  assignmentToHqTime    DateTime?         @map("assignment_to_hq_time")
  contactFormNumber     String?           @map("contact_form_number")
  designStage           ProjectDesignStage? @map("design_stage")
  urgencyLevel          UrgencyLevel      @default(NORMAL) @map("urgency_level")
  hasCustomSchedule     Boolean           @default(false) @map("has_custom_schedule")
  language              TaskLanguage      @default(CHINESE)
  approvalLevel        ApprovalLevel?    @map("approval_level")
  actualCompletionTime DateTime?         @map("actual_completion_time")
  actualWorkdays        Int?              @map("actual_workdays")
  completionStatus      CompletionStatus? @map("completion_status")
  remark                String?
  createdAt    DateTime   @default(now()) @map("created_at")
  createdBy    String     @map("created_by")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  updatedBy    String     @map("updated_by")
  deletedAt    DateTime?  @map("deleted_at")
  deletedBy    String?    @map("deleted_by")

  project            Project          @relation(fields: [projectId], references: [id])
  milestone          Milestone?       @relation(fields: [milestoneId], references: [id])
  parentTask         Task?            @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  childTasks         Task[]           @relation("TaskHierarchy")
  dispatcherUser       User?            @relation("TaskDispatcher", fields: [dispatcherUserId], references: [id])
  supervisingChiefUser User?            @relation("TaskSupervisingChief", fields: [supervisingChiefUserId], references: [id])
  assignedPersonUser   User?            @relation("TaskAssignedPerson", fields: [assignedPersonUserId], references: [id])
  predecessorLinks     TaskDependency[] @relation("PredecessorTask")
  successorLinks     TaskDependency[]  @relation("SuccessorTask")
  disciplines        TaskDiscipline[]

  @@unique([projectId, overseasTaskNumber], map: "uq_task_project_overseas_task_number")
  @@index([projectId], map: "idx_task_project_id")
  @@index([projectId, deletedAt], map: "idx_task_project_deleted")
  @@index([milestoneId], map: "idx_task_milestone_id")
  @@index([dispatcherUserId], map: "idx_task_dispatcher_user_id")
  @@index([supervisingChiefUserId], map: "idx_task_supervising_chief_user_id")
  @@index([assignedPersonUserId], map: "idx_task_assigned_person_user_id")
  @@map("task")
}

model TaskDiscipline {
  id                     String                       @id @default(uuid())
  taskId                 String                       @map("task_id")
  companyId              String                       @map("company_id")
  disciplineId           String?                      @map("discipline_id")
  /// @deprecated Use disciplineId - retained for migration/audit.
