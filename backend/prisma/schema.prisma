// ─── RBAC ────────────────────────────────────────────────────────────────────

model Role {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  parentRoleId String?   @map("parent_role_id")
  name         String
  description  String?
  isSystemRole Boolean   @default(false) @map("is_system_role")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  company         Company          @relation(fields: [companyId], references: [id])
  parentRole      Role?            @relation("RoleInheritance", fields: [parentRoleId], references: [id])
  childRoles      Role[]           @relation("RoleInheritance")
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  documentAccess  DocumentAccess[]
  dashboardWidgets DashboardWidget[]

  @@unique([companyId, name], map: "uq_role_company_name")
  @@index([companyId], map: "idx_role_company_id")
  @@index([companyId, deletedAt], map: "idx_role_company_deleted")
  @@index([parentRoleId], map: "idx_role_parent_role_id")
  @@map("role")
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  isPrimary  Boolean   @default(false) @map("is_primary")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String    @map("assigned_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String    @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String    @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  user       User        @relation(fields: [userId], references: [id])
  role       Role        @relation(fields: [roleId], references: [id])
  dataScopes DataScope[]

  @@unique([userId, roleId], map: "uq_user_role_user_role")
  @@index([userId], map: "idx_user_role_user_id")
  @@index([roleId], map: "idx_user_role_role_id")
  @@index([deletedAt], map: "idx_user_role_deleted_at")
  @@map("user_role")
}

model Permission {
  id          String @id @default(uuid())
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action], map: "uq_permission_module_action")
  @@map("permission")
}

model RolePermission {
  id           String    @id @default(uuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  canView      Boolean   @default(false) @map("can_view")
  canCreate    Boolean   @default(false) @map("can_create")
  canEdit      Boolean   @default(false) @map("can_edit")
  canDelete    Boolean   @default(false) @map("can_delete")
  canApprove   Boolean   @default(false) @map("can_approve")
  canExport    Boolean   @default(false) @map("can_export")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId], map: "uq_role_permission_role_permission")
  @@index([roleId], map: "idx_role_permission_role_id")
  @@index([permissionId], map: "idx_role_permission_permission_id")
  @@map("role_permission")
}

model DataScope {
  id         String        @id @default(uuid())
  userRoleId String        @map("user_role_id")
  scopeType  DataScopeType @map("scope_type")
  scopeValue String        @map("scope_value")
  createdAt  DateTime      @default(now()) @map("created_at")
  createdBy  String        @map("created_by")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  updatedBy  String        @map("updated_by")
  deletedAt  DateTime?     @map("deleted_at")
  deletedBy  String?       @map("deleted_by")

  userRole UserRole @relation(fields: [userRoleId], references: [id])

  @@index([userRoleId], map: "idx_data_scope_user_role_id")
  @@index([deletedAt], map: "idx_data_scope_deleted_at")
  @@map("data_scope")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id              String         @id @default(uuid())
  userId          String?        @map("user_id")
  companyId       String         @map("company_id")
  sessionId       String?        @map("session_id")
  correlationId   String?        @map("correlation_id")
  batchId         String?        @map("batch_id")
  source          AuditLogSource @default(USER_ACTION)
  module          String
  action          String
  recordType      String         @map("record_type")
  recordId        String         @map("record_id")
  recordReference String?        @map("record_reference")
  beforeValue     Json?          @map("before_value")
  afterValue      Json?          @map("after_value")
  ipAddress       String?        @map("ip_address")
  deviceInfo      String?        @map("device_info")
  createdAt       DateTime       @default(now()) @map("created_at")

  user    User?        @relation(fields: [userId], references: [id])
  company Company      @relation(fields: [companyId], references: [id])
