  date                     DateTime          @db.Date
  clockInMachine           String?           @map("clock_in_machine")
  clockOutMachine          String?           @map("clock_out_machine")
  clockInLocal             String?           @map("clock_in_local")
  clockOutLocal            String?           @map("clock_out_local")
  isHoliday                Boolean           @default(false) @map("is_holiday")
  holidayName              String?           @map("holiday_name")
  isWeekend                Boolean           @default(false) @map("is_weekend")
  isHalfDay                Boolean           @default(false) @map("is_half_day")
  wasPresent               Boolean           @default(false) @map("was_present")
  scheduledHours           Decimal           @default(0) @map("scheduled_hours") @db.Decimal(4, 1)
  recordedHours            Decimal?          @map("recorded_hours") @db.Decimal(5, 2)
  isLate                   Boolean           @default(false) @map("is_late")
  lateMinutes              Int               @default(0) @map("late_minutes")
  missingClockIn           Boolean           @default(false) @map("missing_clock_in")
  missingClockOut          Boolean           @default(false) @map("missing_clock_out")
  isEarlyLeave             Boolean           @default(false) @map("is_early_leave")
  earlyLeaveMinutes        Int               @default(0) @map("early_leave_minutes")
  earlyDepartureBand       String?           @map("early_departure_band")
  earlyDepartureWouldDeduct Decimal          @default(0) @map("early_departure_would_deduct") @db.Decimal(3, 2)
  flag                     AttendanceDayFlag @default(NONE)
  flagResolved             Boolean           @default(false) @map("flag_resolved")
  flagResolvedAt           DateTime?         @map("flag_resolved_at")
  fieldMovementEntryId     String?           @map("field_movement_entry_id")
  correctedClockInLocal    String?           @map("corrected_clock_in_local")
  correctedClockOutLocal   String?           @map("corrected_clock_out_local")
  isLastExportDay          Boolean           @default(false) @map("is_last_export_day")
  dayStatus                AttendanceDayStatus @default(PRESENT) @map("day_status")
  dayDeduction             Decimal           @default(0) @map("day_deduction") @db.Decimal(3, 2)
  siteAssignmentName       String?           @map("site_assignment_name")
  /// SCAN_ONLY schedule: earliest scan later than the schedule's latestScanTime.
  scanReviewFlag           AttendanceScanReviewFlag? @map("scan_review_flag")
  /// Earliest scan (HH:mm) that raised scanReviewFlag.
  scanReviewTime           String?           @map("scan_review_time")
  /// True while scanReviewFlag is set and HR has not decided yet.
  needsReview              Boolean           @default(false) @map("needs_review")
  /// HR decision on the flag. No pay effect either way.
  scanReviewDecision       AttendanceScanReviewDecision? @map("scan_review_decision")
  scanReviewNote           String?           @map("scan_review_note")
  scanReviewedById         String?           @map("scan_reviewed_by_id")
  scanReviewedAt           DateTime?         @map("scan_reviewed_at")

  record               AttendanceRecord              @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  scanReviewedBy       User?                         @relation("AttendanceScanReviewer", fields: [scanReviewedById], references: [id])
  corrections          AttendanceDailyLogCorrection[]
  fieldMovementEntries FieldMovementEntry[]

  @@unique([attendanceRecordId, date], map: "uq_attendance_daily_log_record_date")
  @@index([attendanceRecordId], map: "idx_attendance_daily_log_record")
  @@index([date], map: "idx_attendance_daily_log_date")
  @@index([scanReviewFlag], map: "idx_attendance_daily_log_scan_review_flag")
  @@map("attendance_daily_log")
}

model AttendanceMonthlyApproval {
  id                  String                @id @default(uuid())
  companyId           String                @map("company_id")
  importBatchId       String                @unique @map("import_batch_id")
  month               Int
  year                Int
  status              AttendanceMonthStatus @default(PENDING_REVIEW)
  reviewedAt          DateTime?             @map("reviewed_at")
  reviewedBy          String?               @map("reviewed_by")
  approvedAt          DateTime?             @map("approved_at")
  approvedBy          String?               @map("approved_by")
  unlockedAt          DateTime?             @map("unlocked_at")
  unlockedBy          String?               @map("unlocked_by")
  unlockReason        String?               @map("unlock_reason")
  notificationsSentAt DateTime?             @map("notifications_sent_at")
  /// Set when site/WFH/leave approval could not recalculate because this month is APPROVED.
  attendanceRecalcStale Boolean             @default(false) @map("attendance_recalc_stale")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  company     Company               @relation(fields: [companyId], references: [id])
  importBatch AttendanceImportBatch @relation(fields: [importBatchId], references: [id])
  reviewer    User?                 @relation("AttendanceReviewer", fields: [reviewedBy], references: [id])
  approver    User?                 @relation("AttendanceApprover", fields: [approvedBy], references: [id])
  unlocker    User?                 @relation("AttendanceUnlocker", fields: [unlockedBy], references: [id])

  @@unique([companyId, month, year])
  @@index([companyId], map: "idx_attendance_monthly_approval_company")
  @@index([status], map: "idx_attendance_monthly_approval_status")
  @@map("attendance_monthly_approval")
}

model FieldMovementLog {
  id                String              @id @default(uuid())
  companyId         String              @map("company_id")
  requestNumber     String              @map("request_number")
  employeeId        String              @map("employee_id")
  month             Int
  year              Int
  status            FieldMovementStatus @default(DRAFT)
  notes             String?
  approvalRequestId String?             @unique @map("approval_request_id")
  isLateSubmission  Boolean             @default(false) @map("is_late_submission")
  lateReason        String?             @map("late_reason")
  submittedAt       DateTime?           @map("submitted_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  createdBy         String              @map("created_by")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  updatedBy         String              @map("updated_by")
  deletedAt         DateTime?           @map("deleted_at")
  deletedBy         String?             @map("deleted_by")

  company         Company              @relation(fields: [companyId], references: [id])
  employee        User                 @relation("FieldMovementEmployee", fields: [employeeId], references: [id])
  creator         User                 @relation("FieldMovementCreator", fields: [createdBy], references: [id])
  approvalRequest ApprovalRequest?     @relation(fields: [approvalRequestId], references: [id])
  entries         FieldMovementEntry[]

  @@unique([companyId, requestNumber])
  @@index([companyId], map: "idx_field_movement_log_company")
  @@index([employeeId], map: "idx_field_movement_log_employee")
  @@index([status], map: "idx_field_movement_log_status")
  @@index([companyId, month, year], map: "idx_field_movement_log_period")
  @@index([companyId, deletedAt], map: "idx_field_movement_log_deleted")
  @@map("field_movement_log")
}

model FieldMovementEntry {
  id            String              @id @default(uuid())
  logId         String              @map("log_id")
  dailyLogId    String              @map("daily_log_id")
  date          DateTime            @db.Date
  reason        FieldMovementReason
  status        FieldMovementStatus @default(DRAFT)
  destination   String?
  departureTime String?             @map("departure_time")
  returnTime    String?             @map("return_time")
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at")

  log      FieldMovementLog   @relation(fields: [logId], references: [id], onDelete: Cascade)
  dailyLog AttendanceDailyLog @relation(fields: [dailyLogId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Same day may have complementary FORGOT_CLOCK_IN + FORGOT_CLOCK_OUT entries.
  @@unique([logId, dailyLogId, reason], map: "uq_field_movement_entry_log_day_reason")
  @@index([logId], map: "idx_field_movement_entry_log")
  @@index([dailyLogId], map: "idx_field_movement_entry_daily_log")
  @@index([status], map: "idx_field_movement_entry_status")
  @@map("field_movement_entry")
}

model AttendanceDailyLogCorrection {
  id                     String   @id @default(uuid())
  dailyLogId             String   @map("daily_log_id")
  correctedBy            String   @map("corrected_by")
  originalClockInLocal   String?  @map("original_clock_in_local")
  originalClockOutLocal  String?  @map("original_clock_out_local")
  correctedClockInLocal  String?  @map("corrected_clock_in_local")
  correctedClockOutLocal String?  @map("corrected_clock_out_local")
  correctionNote         String   @map("correction_note")
  correctedAt            DateTime @default(now()) @map("corrected_at")

  dailyLog  AttendanceDailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  corrector User               @relation("AttendanceCorrector", fields: [correctedBy], references: [id])

  @@index([dailyLogId], map: "idx_attendance_daily_log_correction_daily_log")
  @@map("attendance_daily_log_correction")
}

// ─── Flight Applications ─────────────────────────────────────────────────────

enum FlightTripType {
  ONE_WAY
  ROUND_TRIP
}

enum FlightTicketClass {
  ECONOMY
  BUSINESS
}

enum FlightVisaStatus {
  NOT_APPLIED
  APPLIED
  APPROVED
}

enum FlightApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum FlightAcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
}

model FlightApplication {
  id                       String                  @id @default(uuid())
  companyId                String                  @map("company_id")
  applicationNumber        String                  @map("application_number")
  submittedBy              String                  @map("submitted_by")
  tripType                 FlightTripType          @map("trip_type")
  isInternational          Boolean                 @default(false) @map("is_international")
  originCountry            String                  @map("origin_country")
  originCity               String                  @map("origin_city")
  destination              String
  departureDate            DateTime                @map("departure_date")
  returnDate               DateTime?               @map("return_date")
  purpose                  String
  ticketClass              FlightTicketClass       @default(ECONOMY) @map("ticket_class")
  notes                    String?
  linkedBusinessTripId     String?                 @map("linked_business_trip_id")
  siteAssignmentId         String?                 @map("site_assignment_id")
  status                   FlightApplicationStatus @default(DRAFT)
  approvalRequestId        String?                 @unique @map("approval_request_id")
  attachmentFolderId       String?                 @map("attachment_folder_id")
  combinedTicketDocumentId String?                 @map("combined_ticket_document_id")
  submittedAt              DateTime?               @map("submitted_at")
  completedAt              DateTime?               @map("completed_at")
  createdAt                DateTime                @default(now()) @map("created_at")
  createdBy                String                  @map("created_by")
  updatedAt                DateTime                @default(now()) @updatedAt @map("updated_at")
  updatedBy                String                  @map("updated_by")
  deletedAt                DateTime?               @map("deleted_at")
  deletedBy                String?                 @map("deleted_by")

  company        Company          @relation(fields: [companyId], references: [id])
  submitter      User             @relation("FlightSubmitter", fields: [submittedBy], references: [id])
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  attachmentFolder DocumentFolder? @relation(fields: [attachmentFolderId], references: [id])
  combinedTicket Document?        @relation("FlightCombinedTicket", fields: [combinedTicketDocumentId], references: [id])
  creator        User             @relation("FlightCreator", fields: [createdBy], references: [id])
  passengers     FlightPassenger[]
  documents      FlightApplicationDocument[]
  perDiemRequests PerDiemRequest[]
  linkedBusinessTrip BusinessTrip?    @relation("FlightLinkedBusinessTrip", fields: [linkedBusinessTripId], references: [id])
  siteAssignment     SiteAssignment?  @relation("FlightSiteAssignment", fields: [siteAssignmentId], references: [id])

  @@unique([companyId, applicationNumber], map: "uq_flight_application_company_number")
  @@index([companyId], map: "idx_flight_application_company")
  @@index([submittedBy], map: "idx_flight_application_submitted_by")
  @@index([status], map: "idx_flight_application_status")
  @@index([companyId, deletedAt], map: "idx_flight_application_company_deleted")
  @@index([attachmentFolderId], map: "idx_flight_application_attachment_folder")
  @@index([linkedBusinessTripId], map: "idx_flight_application_linked_business_trip")
  @@index([siteAssignmentId], map: "idx_flight_application_site_assignment")
  @@map("flight_application")
}

model FlightPassenger {
  id                    String                      @id @default(uuid())
  applicationId         String                      @map("application_id")
  employeeId            String                      @map("employee_id")
  passportNumber        String?                     @map("passport_number")
  visaRequired          Boolean                     @default(false) @map("visa_required")
  visaStatus            FlightVisaStatus?           @default(NOT_APPLIED) @map("visa_status")
  ticketDocumentId      String?                     @map("ticket_document_id")
  acknowledgementStatus FlightAcknowledgementStatus @default(PENDING) @map("acknowledgement_status")
  acknowledgedAt        DateTime?                   @map("acknowledged_at")
  createdAt             DateTime                    @default(now()) @map("created_at")

  application FlightApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employee    User              @relation("FlightPassenger", fields: [employeeId], references: [id])
  ticket      Document?         @relation("PassengerTicket", fields: [ticketDocumentId], references: [id])

  @@unique([applicationId, employeeId], map: "uq_flight_passenger_application_employee")
  @@index([applicationId], map: "idx_flight_passenger_application")
  @@index([employeeId], map: "idx_flight_passenger_employee")
  @@map("flight_passenger")
}

model FlightApplicationDocument {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  documentId    String   @map("document_id")
  createdAt     DateTime @default(now()) @map("created_at")

  application FlightApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document    Document          @relation(fields: [documentId], references: [id])

  @@index([applicationId], map: "idx_flight_application_document_application")
  @@index([documentId], map: "idx_flight_application_document_document")
  @@map("flight_application_document")
}

// ─── Business Trips (Third-Country) ──────────────────────────────────────────

enum BusinessTripStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model BusinessTrip {
  id                         String             @id @default(uuid())
  companyId                  String             @map("company_id")
  tripNumber                 String             @map("trip_number")
  submittedBy                String             @map("submitted_by")
  tripType                   FlightTripType     @map("trip_type")
  originCountry              String             @map("origin_country")
  originCity                 String             @map("origin_city")
  destinationCountry         String             @map("destination_country")
  destinationCity            String             @map("destination_city")
  departureDate              DateTime           @map("departure_date")
  returnDate                 DateTime?          @map("return_date")
  purpose                    String
  hostOrganization           String?            @map("host_organization")
  hostContactName            String?            @map("host_contact_name")
  hostContactPhone           String?            @map("host_contact_phone")
  hostContactEmail           String?            @map("host_contact_email")
  expectedOutcomes           String?            @map("expected_outcomes")
  itinerary                  String?
  estimatedAccommodationCost Decimal?           @map("estimated_accommodation_cost") @db.Decimal(12, 2)
  estimatedPerDiem           Decimal?           @map("estimated_per_diem") @db.Decimal(12, 2)
  estimatedOtherCost         Decimal?           @map("estimated_other_cost") @db.Decimal(12, 2)
  estimatedTotalCost         Decimal?           @default(dbgenerated("(COALESCE(estimated_accommodation_cost, (0)::numeric) + COALESCE(estimated_per_diem, (0)::numeric) + COALESCE(estimated_other_cost, (0)::numeric))")) @map("estimated_total_cost") @db.Decimal(12, 2)
  notes                      String?
  status                     BusinessTripStatus @default(DRAFT)
  approvalRequestId          String?            @unique @map("approval_request_id")
  attachmentFolderId         String?            @map("attachment_folder_id")
  combinedTicketDocumentId   String?            @map("combined_ticket_document_id")
  submittedAt                DateTime?          @map("submitted_at")
  completedAt                DateTime?          @map("completed_at")
  createdAt                  DateTime           @default(now()) @map("created_at")
  createdBy                  String             @map("created_by")
  updatedAt                  DateTime           @default(now()) @updatedAt @map("updated_at")
  updatedBy                  String             @map("updated_by")
  deletedAt                  DateTime?          @map("deleted_at")
  deletedBy                  String?            @map("deleted_by")

  company          Company                 @relation(fields: [companyId], references: [id])
  submitter        User                    @relation("BusinessTripSubmitter", fields: [submittedBy], references: [id])
  approvalRequest  ApprovalRequest?        @relation(fields: [approvalRequestId], references: [id])
  attachmentFolder DocumentFolder?         @relation(fields: [attachmentFolderId], references: [id])
  combinedTicket   Document?               @relation("BusinessTripCombinedTicket", fields: [combinedTicketDocumentId], references: [id])
  creator          User                    @relation("BusinessTripCreator", fields: [createdBy], references: [id])
  passengers       BusinessTripPassenger[]
  documents        BusinessTripDocument[]
  perDiemRequests  PerDiemRequest[]
  linkedFlightApplications FlightApplication[] @relation("FlightLinkedBusinessTrip")

  @@unique([companyId, tripNumber], map: "uq_business_trip_company_number")
  @@index([companyId], map: "idx_business_trip_company")
  @@index([submittedBy], map: "idx_business_trip_submitted_by")
  @@index([status], map: "idx_business_trip_status")
  @@index([companyId, deletedAt], map: "idx_business_trip_company_deleted")
  @@index([attachmentFolderId], map: "idx_business_trip_attachment_folder")
  @@map("business_trip")
}

model BusinessTripPassenger {
  id                    String                      @id @default(uuid())
  tripId                String                      @map("trip_id")
  employeeId            String                      @map("employee_id")
  passportNumber        String?                     @map("passport_number")
  visaRequired          Boolean                     @default(true) @map("visa_required")
  visaStatus            FlightVisaStatus?           @default(NOT_APPLIED) @map("visa_status")
  ticketDocumentId      String?                     @map("ticket_document_id")
  acknowledgementStatus FlightAcknowledgementStatus @default(PENDING) @map("acknowledgement_status")
  acknowledgedAt        DateTime?                   @map("acknowledged_at")
  createdAt             DateTime                    @default(now()) @map("created_at")

  trip     BusinessTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  employee User         @relation("BusinessTripPassenger", fields: [employeeId], references: [id])
  ticket   Document?    @relation("BusinessTripPassengerTicket", fields: [ticketDocumentId], references: [id])

  @@unique([tripId, employeeId], map: "uq_business_trip_passenger_trip_employee")
  @@index([tripId], map: "idx_business_trip_passenger_trip")
  @@index([employeeId], map: "idx_business_trip_passenger_employee")
  @@map("business_trip_passenger")
}

// ─── Currency ─────────────────────────────────────────────────────────────

enum SupportedCurrency {
  ETB
  USD
  CNY
}

model ExchangeRate {
  id           String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  companyId    String            @map("company_id")
  baseCurrency SupportedCurrency @default(ETB) @map("base_currency")
  fromCurrency SupportedCurrency @map("from_currency")
  toCurrency   SupportedCurrency @default(ETB) @map("to_currency")
  rate         Decimal           @db.Decimal(18, 6)
  fetchedAt    DateTime          @default(dbgenerated("CURRENT_DATE")) @map("fetched_at") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, fromCurrency, toCurrency, fetchedAt])
  @@index([companyId], map: "idx_exchange_rate_company")
  @@map("exchange_rate")
}

model EmployeePerDiemRate {
  id                  String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  companyId           String            @map("company_id")
  employeeId          String            @unique @map("employee_id")
  domesticRate        Decimal?          @map("domestic_rate") @db.Decimal(12, 2)
  regionalRate        Decimal?          @map("regional_rate") @db.Decimal(12, 2)
  internationalRate   Decimal?          @map("international_rate") @db.Decimal(12, 2)
  domesticActive      Boolean           @default(true) @map("domestic_active")
  regionalActive      Boolean           @default(true) @map("regional_active")
  internationalActive Boolean           @default(true) @map("international_active")
  currency            SupportedCurrency @default(ETB)
  createdAt           DateTime          @default(now()) @map("created_at")
  createdBy           String            @map("created_by")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  updatedBy           String            @map("updated_by")
  deletedAt           DateTime?         @map("deleted_at")
  deletedBy           String?           @map("deleted_by")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee        User             @relation("EmployeePerDiemRateEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator         User             @relation("EmployeePerDiemRateCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater         User             @relation("EmployeePerDiemRateUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  perDiemRequests PerDiemRequest[]

  @@unique([companyId, employeeId])
  @@index([companyId], map: "idx_employee_per_diem_rate_company")
  @@index([companyId, deletedAt], map: "idx_employee_per_diem_rate_company_deleted")
  @@index([employeeId], map: "idx_employee_per_diem_rate_employee")
  @@map("employee_per_diem_rate")
}

// ─── Expense Claims ─────────────────────────────────────────────────────────

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model ExpenseClaim {
  id                 String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  companyId          String             @map("company_id")
  claimNumber        String             @map("claim_number")
  employeeId         String             @map("employee_id")
  title              String
  description        String?
  status             ExpenseClaimStatus @default(DRAFT)
  totalAmountEtb     Decimal            @default(0) @map("total_amount_etb") @db.Decimal(14, 2)
  approvalRequestId  String?            @unique @map("approval_request_id")
  attachmentFolderId String?            @map("attachment_folder_id")
  submittedAt        DateTime?          @map("submitted_at")
  completedAt        DateTime?          @map("completed_at")
  paidAt             DateTime?          @map("paid_at")
  paidById           String?            @map("paid_by_id")
  paymentReference   String?            @map("payment_reference") @db.VarChar(100)
  createdAt          DateTime           @default(now()) @map("created_at")
  createdBy          String             @map("created_by")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  updatedBy          String             @map("updated_by")
  deletedAt          DateTime?          @map("deleted_at")
  deletedBy          String?            @map("deleted_by")

  company          Company            @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee         User               @relation("ExpenseClaimEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvalRequest  ApprovalRequest?   @relation(fields: [approvalRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachmentFolder DocumentFolder?    @relation(fields: [attachmentFolderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator          User               @relation("ExpenseClaimCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater          User               @relation("ExpenseClaimUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paidBy           User?              @relation("ExpenseClaimPaidBy", fields: [paidById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items            ExpenseClaimItem[]

  @@unique([companyId, claimNumber])
  @@index([companyId], map: "idx_expense_claim_company")
  @@index([employeeId], map: "idx_expense_claim_employee")
  @@index([status], map: "idx_expense_claim_status")
  @@index([paidById], map: "idx_expense_claim_paid_by")
  @@map("expense_claim")
}

model ExpenseClaimItem {
  id           String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  claimId      String            @map("claim_id")
  category     String
  description  String
  amount       Decimal           @db.Decimal(14, 2)
  currency     SupportedCurrency @default(ETB)
  amountEtb    Decimal           @map("amount_etb") @db.Decimal(14, 2)
  exchangeRate Decimal           @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  expenseDate  DateTime          @map("expense_date") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  claim    ExpenseClaim              @relation(fields: [claimId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// One item can carry several receipt files (e.g. invoice + payment slip).
  receipts ExpenseClaimItemReceipt[]

  @@index([claimId], map: "idx_expense_claim_item_claim")
  @@map("expense_claim_item")
}

/// A receipt file attached to an expense claim line item.
model ExpenseClaimItemReceipt {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
