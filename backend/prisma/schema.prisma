generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AuditLogSource {
  USER_ACTION
  SYSTEM_JOB
  API_INTEGRATION
  MIGRATION
}

enum FinancialYearStatus {
  OPEN
  CLOSED
}

enum FinancialPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum FolderContextType {
  SYSTEM
  COMPANY
  PROJECT
  DEPARTMENT
  USER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum NumberSeriesResetFrequency {
  NEVER
  YEARLY
  MONTHLY
}

enum CostCentreType {
  DIRECT
  INDIRECT
  OVERHEAD
}

enum CompanySettingDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum DataScopeType {
  COMPANY
  BRANCH
  DIVISION
  DEPARTMENT
  PROJECT
  SELF
}

// ─── Company & Settings ──────────────────────────────────────────────────────

model Company {
  id                String    @id @default(uuid())
  legalName         String    @map("legal_name")
  registrationNumber String?  @map("registration_number")
  vatNumber         String?   @map("vat_number")
  logoUrl           String?   @map("logo_url")
  baseCurrency      String    @default("USD") @map("base_currency")
  defaultLanguage   String    @default("en") @map("default_language")
  defaultTimezone   String    @default("UTC") @map("default_timezone")
  defaultDateFormat String    @default("DD/MM/YYYY") @map("default_date_format")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String    @map("created_by")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String    @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")

  settings         CompanySetting[]
  branches         Branch[]
  divisions        Division[]
  departments      Department[]
  costCentres      CostCentre[]
  positions        Position[]
  financialYears   FinancialYear[]
  financialPeriods FinancialPeriod[]
  numberSeries     NumberSeries[]
  users            User[]
  roles            Role[]
  auditLogs        AuditLog[]
  notificationTemplates NotificationTemplate[]
  notifications    Notification[]
  documentFolders  DocumentFolder[]
  documents        Document[]
  reportDefinitions ReportDefinition[]
  dashboardWidgets DashboardWidget[]

  @@index([deletedAt], map: "idx_company_deleted_at")
  @@map("company")
}

model CompanySetting {
  id        String               @id @default(uuid())
  companyId String               @map("company_id")
  module    String
  key       String
  value     String
  dataType  CompanySettingDataType @default(STRING) @map("data_type")
  isPublic  Boolean              @default(false) @map("is_public")
  createdAt DateTime             @default(now()) @map("created_at")
  createdBy String               @map("created_by")
  updatedAt DateTime             @updatedAt @map("updated_at")
  updatedBy String               @map("updated_by")
  deletedAt DateTime?            @map("deleted_at")
  deletedBy String?              @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, module, key], map: "uq_company_setting_company_module_key")
  @@index([companyId], map: "idx_company_setting_company_id")
  @@index([companyId, deletedAt], map: "idx_company_setting_company_deleted")
  @@map("company_setting")
}

// ─── Organisation ────────────────────────────────────────────────────────────

model Branch {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  name         String
  address      String?
  city         String?
  country      String?
  phone        String?
  isHeadOffice Boolean   @default(false) @map("is_head_office")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]
  users       User[]

  @@index([companyId], map: "idx_branch_company_id")
  @@index([companyId, deletedAt], map: "idx_branch_company_deleted")
  @@map("branch")
}

model Division {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  code        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String    @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]

  @@unique([companyId, code], map: "uq_division_company_code")
  @@index([companyId], map: "idx_division_company_id")
  @@index([companyId, deletedAt], map: "idx_division_company_deleted")
  @@map("division")
}

model Department {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  divisionId String    @map("division_id")
  branchId   String    @map("branch_id")
  name       String
  code       String
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String    @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String    @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  company     Company      @relation(fields: [companyId], references: [id])
  division    Division     @relation(fields: [divisionId], references: [id])
  branch      Branch       @relation(fields: [branchId], references: [id])
  costCentres CostCentre[]
  positions   Position[]
  users       User[]

  @@unique([companyId, code], map: "uq_department_company_code")
  @@index([companyId], map: "idx_department_company_id")
  @@index([companyId, deletedAt], map: "idx_department_company_deleted")
  @@index([divisionId], map: "idx_department_division_id")
  @@index([branchId], map: "idx_department_branch_id")
  @@map("department")
}

model CostCentre {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  departmentId String         @map("department_id")
  name         String
  code         String
  type         CostCentreType @default(DIRECT)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  createdBy    String         @map("created_by")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  updatedBy    String         @map("updated_by")
  deletedAt    DateTime?      @map("deleted_at")
  deletedBy    String?        @map("deleted_by")

  company    Company    @relation(fields: [companyId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([companyId, code], map: "uq_cost_centre_company_code")
  @@index([companyId], map: "idx_cost_centre_company_id")
  @@index([companyId, deletedAt], map: "idx_cost_centre_company_deleted")
  @@index([departmentId], map: "idx_cost_centre_department_id")
  @@map("cost_centre")
}

model Position {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  departmentId String    @map("department_id")
  title        String
  grade        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  company    Company    @relation(fields: [companyId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  users      User[]

  @@index([companyId], map: "idx_position_company_id")
  @@index([companyId, deletedAt], map: "idx_position_company_deleted")
  @@index([departmentId], map: "idx_position_department_id")
  @@map("position")
}

// ─── Financial ───────────────────────────────────────────────────────────────

model FinancialYear {
  id        String              @id @default(uuid())
  companyId String              @map("company_id")
  name      String
  startDate DateTime            @map("start_date") @db.Date
  endDate   DateTime            @map("end_date") @db.Date
  status    FinancialYearStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")
  createdBy String              @map("created_by")
  updatedAt DateTime            @updatedAt @map("updated_at")
  updatedBy String              @map("updated_by")

  company  Company           @relation(fields: [companyId], references: [id])
  periods  FinancialPeriod[]

  @@index([companyId], map: "idx_financial_year_company_id")
  @@map("financial_year")
}

model FinancialPeriod {
  id                  String                @id @default(uuid())
  companyId           String                @map("company_id")
  financialYearId     String                @map("financial_year_id")
  name                String
  periodNumber        Int                   @map("period_number")
  startDate           DateTime              @map("start_date") @db.Date
  endDate             DateTime              @map("end_date") @db.Date
  status              FinancialPeriodStatus @default(OPEN)
  isAdjustmentPeriod  Boolean               @default(false) @map("is_adjustment_period")
  lockedAt            DateTime?             @map("locked_at")
  lockedBy            String?               @map("locked_by")
  closedAt            DateTime?             @map("closed_at")
  closedBy            String?               @map("closed_by")
  createdAt           DateTime              @default(now()) @map("created_at")
  createdBy           String                @map("created_by")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  updatedBy           String                @map("updated_by")

  company       Company       @relation(fields: [companyId], references: [id])
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@unique([financialYearId, periodNumber], map: "uq_financial_period_year_number")
  @@index([companyId], map: "idx_financial_period_company_id")
  @@index([financialYearId], map: "idx_financial_period_year_id")
  @@map("financial_period")
}

model NumberSeries {
  id             String                   @id @default(uuid())
  companyId      String                   @map("company_id")
  documentType   String                   @map("document_type")
  prefix         String                   @default("")
  suffix         String                   @default("")
  sequenceName   String                   @map("sequence_name")
  padding        Int                      @default(5)
  resetFrequency NumberSeriesResetFrequency @default(NEVER) @map("reset_frequency")
  createdAt      DateTime                 @default(now()) @map("created_at")
  createdBy      String                   @map("created_by")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  updatedBy      String                   @map("updated_by")
  deletedAt      DateTime?                @map("deleted_at")
  deletedBy      String?                  @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, documentType], map: "uq_number_series_company_doc_type")
  @@unique([sequenceName], map: "uq_number_series_sequence_name")
  @@index([companyId], map: "idx_number_series_company_id")
  @@index([companyId, deletedAt], map: "idx_number_series_company_deleted")
  @@map("number_series")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  companyId           String    @map("company_id")
  branchId            String?   @map("branch_id")
  departmentId        String?   @map("department_id")
  positionId          String?   @map("position_id")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  email               String
  phone               String?
  passwordHash        String    @map("password_hash")
  preferredLanguage   String?   @map("preferred_language")
  preferredTimezone   String?   @map("preferred_timezone")
  preferredDateFormat String?   @map("preferred_date_format")
  isActive            Boolean   @default(true) @map("is_active")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  lastLogin           DateTime? @map("last_login")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String    @map("created_by")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String    @map("updated_by")
  deletedAt           DateTime? @map("deleted_at")
  deletedBy           String?   @map("deleted_by")

  company                Company                 @relation(fields: [companyId], references: [id])
  branch                 Branch?                 @relation(fields: [branchId], references: [id])
  department             Department?             @relation(fields: [departmentId], references: [id])
  position               Position?               @relation(fields: [positionId], references: [id])
  sessions               UserSession[]
  passwordResetTokens    PasswordResetToken[]
  userRoles              UserRole[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  documentVersions       DocumentVersion[]
  reportDefinitions      ReportDefinition[]

  @@unique([companyId, email], map: "uq_user_company_email")
  @@index([companyId], map: "idx_user_company_id")
  @@index([companyId, deletedAt], map: "idx_user_company_deleted")
  @@index([branchId], map: "idx_user_branch_id")
  @@index([departmentId], map: "idx_user_department_id")
  @@map("user")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  companyId        String   @map("company_id")
  refreshTokenHash String   @map("refresh_token_hash")
  deviceInfo       String?  @map("device_info")
  ipAddress        String?  @map("ip_address")
  expiresAt        DateTime @map("expires_at")
  lastUsedAt       DateTime @default(now()) @map("last_used_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([userId], map: "idx_user_session_user_id")
  @@index([companyId], map: "idx_user_session_company_id")
  @@index([expiresAt], map: "idx_user_session_expires_at")
  @@map("user_session")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_token_user_id")
  @@index([expiresAt], map: "idx_password_reset_token_expires_at")
  @@map("password_reset_token")
}

// ─── RBAC ────────────────────────────────────────────────────────────────────

model Role {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  parentRoleId String?   @map("parent_role_id")
  name         String
  description  String?
  isSystemRole Boolean   @default(false) @map("is_system_role")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  company         Company          @relation(fields: [companyId], references: [id])
  parentRole      Role?            @relation("RoleInheritance", fields: [parentRoleId], references: [id])
  childRoles      Role[]           @relation("RoleInheritance")
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  documentAccess  DocumentAccess[]
  dashboardWidgets DashboardWidget[]

  @@unique([companyId, name], map: "uq_role_company_name")
  @@index([companyId], map: "idx_role_company_id")
  @@index([companyId, deletedAt], map: "idx_role_company_deleted")
  @@index([parentRoleId], map: "idx_role_parent_role_id")
  @@map("role")
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String    @map("assigned_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String    @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String    @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  user       User        @relation(fields: [userId], references: [id])
  role       Role        @relation(fields: [roleId], references: [id])
  dataScopes DataScope[]

  @@unique([userId, roleId], map: "uq_user_role_user_role")
  @@index([userId], map: "idx_user_role_user_id")
  @@index([roleId], map: "idx_user_role_role_id")
  @@index([deletedAt], map: "idx_user_role_deleted_at")
  @@map("user_role")
}

model Permission {
  id          String @id @default(uuid())
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action], map: "uq_permission_module_action")
  @@map("permission")
}

model RolePermission {
  id           String    @id @default(uuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  canView      Boolean   @default(false) @map("can_view")
  canCreate    Boolean   @default(false) @map("can_create")
  canEdit      Boolean   @default(false) @map("can_edit")
  canDelete    Boolean   @default(false) @map("can_delete")
  canApprove   Boolean   @default(false) @map("can_approve")
  canExport    Boolean   @default(false) @map("can_export")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId], map: "uq_role_permission_role_permission")
  @@index([roleId], map: "idx_role_permission_role_id")
  @@index([permissionId], map: "idx_role_permission_permission_id")
  @@map("role_permission")
}

model DataScope {
  id         String        @id @default(uuid())
  userRoleId String        @map("user_role_id")
  scopeType  DataScopeType @map("scope_type")
  scopeValue String        @map("scope_value")
  createdAt  DateTime      @default(now()) @map("created_at")
  createdBy  String        @map("created_by")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  updatedBy  String        @map("updated_by")
  deletedAt  DateTime?     @map("deleted_at")
  deletedBy  String?       @map("deleted_by")

  userRole UserRole @relation(fields: [userRoleId], references: [id])

  @@index([userRoleId], map: "idx_data_scope_user_role_id")
  @@index([deletedAt], map: "idx_data_scope_deleted_at")
  @@map("data_scope")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id              String         @id @default(uuid())
  userId          String?        @map("user_id")
  companyId       String         @map("company_id")
  sessionId       String?        @map("session_id")
  correlationId   String?        @map("correlation_id")
  batchId         String?        @map("batch_id")
  source          AuditLogSource @default(USER_ACTION)
  module          String
  action          String
  recordType      String         @map("record_type")
  recordId        String         @map("record_id")
  recordReference String?        @map("record_reference")
  beforeValue     Json?          @map("before_value")
  afterValue      Json?          @map("after_value")
  ipAddress       String?        @map("ip_address")
  deviceInfo      String?        @map("device_info")
  createdAt       DateTime       @default(now()) @map("created_at")

  user    User?        @relation(fields: [userId], references: [id])
  company Company      @relation(fields: [companyId], references: [id])
  session UserSession? @relation(fields: [sessionId], references: [id])

  @@index([companyId], map: "idx_audit_log_company_id")
  @@index([userId], map: "idx_audit_log_user_id")
  @@index([sessionId], map: "idx_audit_log_session_id")
  @@index([module, action], map: "idx_audit_log_module_action")
  @@index([createdAt], map: "idx_audit_log_created_at")
  @@map("audit_log")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model NotificationTemplate {
  id              String              @id @default(uuid())
  companyId       String              @map("company_id")
  eventType       String              @map("event_type")
  channel         NotificationChannel
  subjectTemplate String              @map("subject_template")
  bodyTemplate    String              @map("body_template")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  createdBy       String              @map("created_by")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  updatedBy       String              @map("updated_by")
  deletedAt       DateTime?           @map("deleted_at")
  deletedBy       String?             @map("deleted_by")

  company       Company        @relation(fields: [companyId], references: [id])
  notifications Notification[]

  @@unique([companyId, eventType, channel], map: "uq_notification_template_company_event_channel")
  @@index([companyId], map: "idx_notification_template_company_id")
  @@index([companyId, deletedAt], map: "idx_notification_template_company_deleted")
  @@map("notification_template")
}

model Notification {
  id          String             @id @default(uuid())
  companyId   String             @map("company_id")
  recipientId String             @map("recipient_id")
  templateId  String?            @map("template_id")
  channel     NotificationChannel
  subject     String
  body        String
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?          @map("sent_at")
  readAt      DateTime?          @map("read_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  company   Company               @relation(fields: [companyId], references: [id])
  recipient User                  @relation(fields: [recipientId], references: [id])
  template  NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([companyId], map: "idx_notification_company_id")
  @@index([recipientId], map: "idx_notification_recipient_id")
  @@index([status], map: "idx_notification_status")
  @@index([createdAt], map: "idx_notification_created_at")
  @@map("notification")
}

model NotificationPreference {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  eventType String    @map("event_type")
  inApp     Boolean   @default(true) @map("in_app")
  email     Boolean   @default(true)
  sms       Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String    @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, eventType], map: "uq_notification_preference_user_event")
  @@index([userId], map: "idx_notification_preference_user_id")
  @@map("notification_preference")
}

// ─── Documents ───────────────────────────────────────────────────────────────

model DocumentFolder {
  id          String            @id @default(uuid())
  companyId   String            @map("company_id")
  parentId    String?           @map("parent_id")
  name        String
  path        String
  contextType FolderContextType @map("context_type")
  contextId   String?           @map("context_id")
  isSystem    Boolean           @default(false) @map("is_system")
  createdAt   DateTime          @default(now()) @map("created_at")
  createdBy   String            @map("created_by")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  updatedBy   String            @map("updated_by")
  deletedAt   DateTime?         @map("deleted_at")
  deletedBy   String?           @map("deleted_by")

  company        Company          @relation(fields: [companyId], references: [id])
  parent         DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children       DocumentFolder[] @relation("FolderHierarchy")
  documents      Document[]
  documentAccess DocumentAccess[]

  @@index([companyId], map: "idx_document_folder_company_id")
  @@index([companyId, deletedAt], map: "idx_document_folder_company_deleted")
  @@index([parentId], map: "idx_document_folder_parent_id")
  @@index([contextType, contextId], map: "idx_document_folder_context")
  @@map("document_folder")
}

model Document {
  id            String    @id @default(uuid())
  folderId      String    @map("folder_id")
  companyId     String    @map("company_id")
  name          String
  fileKey       String    @map("file_key")
  fileType      String    @map("file_type")
  fileSizeBytes Int       @map("file_size_bytes")
  version       Int       @default(1)
  isCurrent     Boolean   @default(true) @map("is_current")
  expiryDate    DateTime? @map("expiry_date") @db.Date
  isMandatory   Boolean   @default(false) @map("is_mandatory")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String    @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")

  company  Company           @relation(fields: [companyId], references: [id])
  folder   DocumentFolder    @relation(fields: [folderId], references: [id])
  versions DocumentVersion[]

  @@index([companyId], map: "idx_document_company_id")
  @@index([companyId, deletedAt], map: "idx_document_company_deleted")
  @@index([folderId], map: "idx_document_folder_id")
  @@map("document")
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String   @map("document_id")
  uploadedBy    String   @map("uploaded_by")
  versionNumber Int      @map("version_number")
  fileKey       String   @map("file_key")
  fileSizeBytes Int      @map("file_size_bytes")
  changeNote    String?  @map("change_note")
  createdAt     DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id])
  uploader User     @relation(fields: [uploadedBy], references: [id])

  @@unique([documentId, versionNumber], map: "uq_document_version_doc_number")
  @@index([documentId], map: "idx_document_version_document_id")
  @@index([uploadedBy], map: "idx_document_version_uploaded_by")
  @@map("document_version")
}

model DocumentAccess {
  id          String    @id @default(uuid())
  folderId    String    @map("folder_id")
  roleId      String    @map("role_id")
  canView     Boolean   @default(false) @map("can_view")
  canUpload   Boolean   @default(false) @map("can_upload")
  canDownload Boolean   @default(false) @map("can_download")
  canDelete   Boolean   @default(false) @map("can_delete")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String    @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  folder DocumentFolder @relation(fields: [folderId], references: [id])
  role   Role           @relation(fields: [roleId], references: [id])

  @@unique([folderId, roleId], map: "uq_document_access_folder_role")
  @@index([folderId], map: "idx_document_access_folder_id")
  @@index([roleId], map: "idx_document_access_role_id")
  @@map("document_access")
}

// ─── Reporting ───────────────────────────────────────────────────────────────

model ReportDefinition {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  createdBy  String    @map("created_by")
  name       String
  dataSource String    @map("data_source")
  fields     Json      @default("[]")
  filters    Json      @default("[]")
  grouping   Json      @default("[]")
  sorting    Json      @default("[]")
  isSystem   Boolean   @default(false) @map("is_system")
  isShared   Boolean   @default(false) @map("is_shared")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String    @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  company   Company          @relation(fields: [companyId], references: [id])
  creator   User             @relation(fields: [createdBy], references: [id])
  schedules ReportSchedule[]

  @@index([companyId], map: "idx_report_definition_company_id")
  @@index([companyId, deletedAt], map: "idx_report_definition_company_deleted")
  @@index([createdBy], map: "idx_report_definition_created_by")
  @@map("report_definition")
}

model ReportSchedule {
  id             String    @id @default(uuid())
  reportId       String    @map("report_id")
  cronExpression String    @map("cron_expression")
  format         String    @default("PDF")
  recipients     Json      @default("[]")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String    @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String    @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  report ReportDefinition @relation(fields: [reportId], references: [id])

  @@index([reportId], map: "idx_report_schedule_report_id")
  @@map("report_schedule")
}

model DashboardWidget {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  roleId    String    @map("role_id")
  widgetType String   @map("widget_type")
  title     String
  config    Json      @default("{}")
  positionX Int       @default(0) @map("position_x")
  positionY Int       @default(0) @map("position_y")
  width     Int       @default(4)
  height    Int       @default(2)
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String    @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@index([companyId], map: "idx_dashboard_widget_company_id")
  @@index([roleId], map: "idx_dashboard_widget_role_id")
  @@index([companyId, deletedAt], map: "idx_dashboard_widget_company_deleted")
  @@map("dashboard_widget")
}
