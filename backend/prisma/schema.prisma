model DailyLog {
  id                String   @id @default(uuid())
  projectId         String   @map("project_id")
  siteEngineerId    String   @map("site_engineer_id")
  logDate           DateTime @map("log_date") @db.Date
  shift             String?
  weatherCondition  String?  @map("weather_condition")
  temperatureC      Decimal? @map("temperature_c") @db.Decimal(6, 2)
  rainfallMm        Decimal? @map("rainfall_mm") @db.Decimal(8, 2)
  workSummary       String?  @map("work_summary")
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String   @map("created_by")
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedBy         String   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?  @map("deleted_by")

  project    Project             @relation(fields: [projectId], references: [id])
