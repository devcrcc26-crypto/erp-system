model LeaveBalance {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  employeeId String    @map("employee_id")
  year       Int
  leaveType      LeaveType @map("leave_type")
  entitled       Decimal   @default(0) @db.Decimal(4, 1)
  broughtForward Decimal   @default(0) @map("brought_forward") @db.Decimal(4, 1)
  used           Decimal   @default(0) @db.Decimal(4, 1)
  pending        Decimal   @default(0) @db.Decimal(4, 1)
  remaining      Decimal?  @default(dbgenerated("(((entitled + brought_forward) - used) - pending)")) @db.Decimal(4, 1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  company  Company @relation(fields: [companyId], references: [id])
  employee User    @relation("LeaveBalance", fields: [employeeId], references: [id])

  @@unique([companyId, employeeId, year, leaveType])
  @@index([employeeId, year])
  @@map("leave_balance")
}

/// Leave balance ledger entry kind. Balance = sum of entries (USED / EXPIRED negative).
enum LeaveBalanceEntryKind {
  ENTITLEMENT
  CARRY_OVER
  ADJUSTMENT
  OPENING_BALANCE
  USED
  EXPIRED
}

/// Append-only leave ledger per employee / leave type / leave year (employment
/// anniversary). leave_balance is a cache of these sums plus pending days.
model LeaveBalanceEntry {
  id                   String                @id @default(uuid())
  companyId            String                @map("company_id")
  employeeId           String                @map("employee_id")
  leaveType            LeaveType             @map("leave_type")
  leaveYearStart       DateTime              @map("leave_year_start") @db.Date
  leaveYearEnd         DateTime              @map("leave_year_end") @db.Date
  kind                 LeaveBalanceEntryKind
  /// Signed days (0.5 steps): USED / EXPIRED and outgoing carry-over are negative.
  days                 Decimal               @db.Decimal(6, 1)
  reason               String?
  /// Idempotency key for system entries (entitlement, carry-over, expiry, used); null for HR entries.
  dedupeKey            String?               @unique @map("dedupe_key")
  sourceContractId     String?               @map("source_contract_id")
  sourceLeaveRequestId String?               @map("source_leave_request_id")
  /// Null for system / migration entries.
  createdById          String?               @map("created_by_id")
  createdAt            DateTime              @default(now()) @map("created_at")

  company            Company           @relation(fields: [companyId], references: [id])
  employee           User              @relation("LeaveBalanceEntryEmployee", fields: [employeeId], references: [id])
  createdBy          User?             @relation("LeaveBalanceEntryCreator", fields: [createdById], references: [id])
  sourceContract     EmployeeContract? @relation(fields: [sourceContractId], references: [id], onDelete: SetNull)
  sourceLeaveRequest LeaveRequest?     @relation(fields: [sourceLeaveRequestId], references: [id], onDelete: SetNull)

  @@index([employeeId, leaveType, leaveYearStart], map: "idx_leave_balance_entry_employee_year")
  @@index([companyId], map: "idx_leave_balance_entry_company")
  @@index([sourceContractId], map: "idx_leave_balance_entry_contract")
  @@index([sourceLeaveRequestId], map: "idx_leave_balance_entry_leave")
  @@map("leave_balance_entry")
}

enum OvertimeSheetStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model OvertimeSheet {
  id                 String              @id @default(uuid())
  companyId          String              @map("company_id")
  sheetNumber        String              @map("sheet_number")
  employeeId         String              @map("employee_id")
  month              Int
  year               Int
  status             OvertimeSheetStatus @default(DRAFT)
  totalRegularHours  Decimal             @default(0) @map("total_regular_hours") @db.Decimal(6, 2)
  totalNightHours    Decimal             @default(0) @map("total_night_hours") @db.Decimal(6, 2)
  totalWeekendHours  Decimal             @default(0) @map("total_weekend_hours") @db.Decimal(6, 2)
  totalHolidayHours  Decimal             @default(0) @map("total_holiday_hours") @db.Decimal(6, 2)
  totalHours         Decimal?            @default(dbgenerated("(((total_regular_hours + total_night_hours) + total_weekend_hours) + total_holiday_hours)")) @map("total_hours") @db.Decimal(6, 2)
  approvalRequestId  String?             @unique @map("approval_request_id")
  attachmentFolderId String?             @map("attachment_folder_id")
  /// Snapshot of entries at the last APPROVED decision — used for approver edit diffs.
  lastApprovedSnapshot Json?             @map("last_approved_snapshot")
  submittedAt        DateTime?           @map("submitted_at")
  completedAt        DateTime?           @map("completed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  createdBy          String              @map("created_by")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")
  updatedBy          String              @map("updated_by")
  deletedAt          DateTime?           @map("deleted_at")
  deletedBy          String?             @map("deleted_by")

  company          Company          @relation(fields: [companyId], references: [id])
  employee         User             @relation("OvertimeEmployee", fields: [employeeId], references: [id])
  approvalRequest  ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  attachmentFolder DocumentFolder?  @relation(fields: [attachmentFolderId], references: [id])
  creator          User             @relation("OvertimeCreator", fields: [createdBy], references: [id])
  entries          OvertimeEntry[]
  payrollEntries   PayrollEntry[]

  @@unique([companyId, sheetNumber])
  @@unique([companyId, employeeId, month, year], map: "overtime_sheet_company_employee_month_year_key")
  @@index([companyId], map: "idx_overtime_sheet_company")
  @@index([employeeId], map: "idx_overtime_sheet_employee")
  @@index([status], map: "idx_overtime_sheet_status")
  @@index([year, month], map: "idx_overtime_sheet_period")
  @@index([attachmentFolderId], map: "idx_overtime_sheet_attachment_folder")
  @@map("overtime_sheet")
}

model OvertimeEntry {
  id              String   @id @default(uuid())
  sheetId         String   @map("sheet_id")
  date            DateTime @db.Date
  startTime       DateTime @map("start_time") @db.Time(0)
  endTime         DateTime @map("end_time") @db.Time(0)
  /**
   * When true, endTime is stored as 00:00 but means calendar end-of-day (24:00).
   * Distinguishes "24:00" from "00:00" of the same day. New same-day entries only.
   */
  endsAtEndOfDay  Boolean  @default(false) @map("ends_at_end_of_day")
  isHoliday       Boolean  @default(false) @map("is_holiday")
  isOvernight     Boolean  @default(false) @map("is_overnight")
  regularHours    Decimal  @default(0) @map("regular_hours") @db.Decimal(5, 2)
  nightHours      Decimal  @default(0) @map("night_hours") @db.Decimal(5, 2)
  weekendHours    Decimal  @default(0) @map("weekend_hours") @db.Decimal(5, 2)
  holidayHours    Decimal  @default(0) @map("holiday_hours") @db.Decimal(5, 2)
  totalHours      Decimal  @default(dbgenerated("(((regular_hours + night_hours) + weekend_hours) + holiday_hours)")) @map("total_hours") @db.Decimal(5, 2)
  taskDescription String   @map("task_description")
  attendanceWarning String? @map("attendance_warning") @db.VarChar(500)
  /// Approved site assignment covering the entry date when it was classified ("Site assignment" label).
  siteAssignmentId  String?  @map("site_assignment_id")
  /// Part of the bucket hours that fell inside scheduled hours on a site day (already included in totalHours).
  siteWithinScheduleHours Decimal @default(0) @map("site_within_schedule_hours") @db.Decimal(5, 2)
  /// Set when the site assignment was cancelled/shortened after the sheet was submitted (stored hours kept).
  siteReviewFlag      String?   @map("site_review_flag") @db.VarChar(40)
  siteReviewFlaggedAt DateTime? @map("site_review_flagged_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  sheet          OvertimeSheet           @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  documents      OvertimeEntryDocument[]
  siteAssignment SiteAssignment?         @relation(fields: [siteAssignmentId], references: [id], onDelete: SetNull)

  @@unique([sheetId, date, startTime, endTime])
  @@index([sheetId], map: "idx_overtime_entry_sheet")
  @@index([date], map: "idx_overtime_entry_date")
  @@index([siteAssignmentId], map: "idx_overtime_entry_site_assignment")
  @@map("overtime_entry")
}

model OvertimeEntryDocument {
  id         String   @id @default(uuid())
  entryId    String   @map("entry_id")
  documentId String   @map("document_id")
  createdAt  DateTime @default(now()) @map("created_at")

  entry    OvertimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  document Document      @relation(fields: [documentId], references: [id])

  @@index([entryId], map: "idx_overtime_entry_document_entry")
  @@index([documentId], map: "idx_overtime_entry_document_document")
  @@map("overtime_entry_document")
}

// ─── Attendance ──────────────────────────────────────────────────────────────

enum AttendanceMonthStatus {
  PENDING_REVIEW
  REVIEWED
  APPROVED
  UNLOCKED
}

enum FieldMovementReason {
  FIELD_VISIT
  EARLY_LEAVE
  FORGOT_CLOCK_IN
  FORGOT_CLOCK_OUT
}

enum FieldMovementStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum AttendanceDayFlag {
  MISSING_CLOCK_IN
  MISSING_CLOCK_OUT
  EARLY_LEAVE
  /// Approved leave day that still has a clock-in and/or clock-out (HR review).
  ON_LEAVE_BUT_SCANNED
  /// Scan on a day after the employee's leaving date (info only; day is outside employment).
  SCAN_AFTER_SEPARATION
  NONE
}

enum AttendanceScanReviewFlag {
  SCAN_AFTER_DEADLINE
}

enum AttendanceScanReviewDecision {
  EXCUSED
  MARKED_LATE
}

enum AttendanceDayStatus {
  PRESENT
  ABSENT
  HALF_ABSENT
  /// Legacy calendar Sunday; new writes use DAY_OFF from the work schedule.
  SUNDAY
  /// Schedule day off (incl. Sunday when the schedule says so).
  DAY_OFF
  /// Scanned on a schedule day off - info only; deduction 0, no pay change.
  WORKED_ON_DAY_OFF
  HOLIDAY
  WORK_FROM_HOME
  ON_SITE
  LEAVE
  /// Approved UNPAID leave - deduction 1; not attended / not paid.
  UNPAID_LEAVE
  FIELD_MOVEMENT_PENDING
  /// Hire → first scan grace (not absent); first N working days only.
  ENROLMENT_GRACE
  /// After the employee's leaving date - outside employment, neither paid nor absent.
  NOT_EMPLOYED
  /// Inside an InactivePeriod - deduction 0 (paid) or 1 (unpaid) per the inactivePaid policy.
  INACTIVE
}

enum WorkFromHomeScope {
  ALL
  DEPARTMENTS
  EMPLOYEES
}

enum AttendanceMode {
  SCANNER
  EXEMPT
}

enum AttendanceIdentityStatus {
  MAPPED
  IGNORED
}

enum AttendanceMatchMethod {
  IDENTITY
  EMPLOYEE_ID
  NAME_HIGH
  NAME_REVIEW
  MANUAL
  EXEMPT
  MANUAL_PRESENT
  /// Not yet enrolled on the attendance machine - counted present.
  NEEDS_ENROLMENT
  /// Missing from file but every working day covered by approved site / WFH / leave.
  COVERED
}

enum AttendanceUnmatchedStatus {
  UNMATCHED
  IGNORED
}

enum AttendanceMissingResolution {
  PENDING
  MARKED_EXEMPT
  MANUAL_PRESENT
  NEEDS_ENROLMENT
  COVERED
}

model AttendanceIdentity {
