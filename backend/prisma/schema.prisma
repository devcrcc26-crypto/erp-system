  @@unique([companyId, requestNumber])
  @@index([companyId], map: "idx_vehicle_refueling_company")
  @@index([employeeId], map: "idx_vehicle_refueling_employee")
  @@index([vehicleId], map: "idx_vehicle_refueling_vehicle")
  @@index([driverId], map: "idx_vehicle_refueling_driver")
  @@index([status], map: "idx_vehicle_refueling_status")
  @@index([companyId, deletedAt], map: "idx_vehicle_refueling_company_deleted")
  @@index([attachmentFolderId], map: "idx_vehicle_refueling_attachment_folder")
  @@index([receiptDocumentId], map: "idx_vehicle_refueling_receipt")
  @@map("vehicle_refueling")
}

enum InspectionRepairUrgency {
  CRITICAL
  URGENT
  MEDIUM
  MINOR
}

enum InspectionRepairStatus {
  DRAFT
  SUBMITTED
  IN_REPAIR
  REPAIRED
  REJECTED
}

enum InspectionRepairType {
  INSPECTION
  MAINTENANCE
  REPAIR
}

model InspectionRepair {
  id                 String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  companyId          String                  @map("company_id")
  employeeId         String                  @map("employee_id")
  assetId            String?                 @map("asset_id")
  location           String
  deviceName         String                  @map("device_name")
  description        String
  make               String?
  model              String?
  year               Int?
  urgency            InspectionRepairUrgency @default(MINOR)
  solution           String?
  requestNumber      String                  @map("inspection_repair_number")
  approvalRequestId  String?                 @unique @map("approval_request_id")
  attachmentFolderId String?                 @map("attachment_folder_id")
  inspectionType     InspectionRepairType    @map("inspection_type")
  status             InspectionRepairStatus  @default(DRAFT)
  submittedAt        DateTime?               @map("submitted_at")
  completedAt        DateTime?               @map("completed_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  createdBy          String                  @map("created_by")
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at")
  updatedBy          String                  @map("updated_by")
  deletedAt          DateTime?               @map("deleted_at")
  deletedBy          String?                 @map("deleted_by")

  company          Company         @relation(fields: [companyId], references: [id])
  employee         User            @relation("InspectionRepairEmployee", fields: [employeeId], references: [id])
  asset            CompanyAsset?   @relation(fields: [assetId], references: [id])
  approvalRequest  ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  attachmentFolder DocumentFolder? @relation(fields: [attachmentFolderId], references: [id])
  creator          User            @relation("InspectionRepairCreator", fields: [createdBy], references: [id])

  @@unique([companyId, requestNumber], map: "uq_inspection_repair_company_number")
  @@index([companyId], map: "idx_inspection_repair_company")
  @@index([employeeId], map: "idx_inspection_repair_employee")
  @@index([assetId], map: "idx_inspection_repair_asset")
  @@index([status], map: "idx_inspection_repair_status")
  @@index([companyId, deletedAt], map: "idx_inspection_repair_deleted")
  @@index([attachmentFolderId], map: "idx_inspection_repair_attachment_folder")
  @@map("inspection_repair")
}




