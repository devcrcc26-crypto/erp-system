}

// ─── Approval Workflow ───────────────────────────────────────────────────────

model ApprovalCategory {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  name             String
  code             String
  description      String?
  icon             String?
  module           String    @default("GENERAL")
  formSchema       Json      @default("[]") @map("form_schema")
  approvalRules    Json      @default("[]") @map("approval_rules")
  numberPrefix     String    @map("number_prefix")
  isActive            Boolean   @default(true) @map("is_active")
  /// When false, category is hidden from New Request and cannot be submitted via the generic API.
  isUserRequestable   Boolean   @default(true) @map("is_user_requestable")
  /// NestJS RBAC permission.module required for create (e.g. leave, vehicle-refueling).
  permissionModule    String?   @map("permission_module")
  allowAttachments    Boolean   @default(true) @map("allow_attachments")
  sortOrder           Int       @default(0) @map("sort_order")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy           String    @map("created_by")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy           String    @map("updated_by")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(6)
  deletedBy           String?   @map("deleted_by")

  company  Company           @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator  User              @relation("CategoryCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater  User              @relation("CategoryUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requests ApprovalRequest[]

  @@unique([companyId, code])
  @@map("approval_category")
}

model ApprovalRequest {
  id                 String                @id @default(uuid())
  companyId          String                @map("company_id")
  categoryId         String                @map("category_id")
  requestNumber      String                @map("request_number")
  title              String
  formData           Json                  @default("{}") @map("form_data")
  requestedBy        String                @map("requested_by")
  status             ApprovalRequestStatus @default(DRAFT)
  currentTier        Int                   @default(0) @map("current_tier")
  matchedRuleName    String?               @map("matched_rule_name")
  submittedAt        DateTime?             @map("submitted_at") @db.Timestamp(6)
  completedAt        DateTime?             @map("completed_at") @db.Timestamp(6)
  attachmentFolderId String?               @map("attachment_folder_id")
  notes              String?
  isLateSubmission   Boolean               @default(false) @map("is_late_submission")
  lateReason         String?               @map("late_reason")
  /// How createdBy (initiator) filed for requestedBy (subject). Null = before 2026-10-17.
  initiatedAs        RequestInitiatorType? @map("initiated_as")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy          String                @map("created_by")
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy          String                @map("updated_by")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamp(6)
  deletedBy          String?               @map("deleted_by")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category         ApprovalCategory  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requester        User              @relation("RequestRequester", fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator          User              @relation("ApprovalRequestCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater          User              @relation("ApprovalRequestUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tiers            ApprovalTier[]
  comments         ApprovalComment[]
  responses        ApprovalResponse[]
  
  attachmentFolder DocumentFolder?   @relation(fields: [attachmentFolderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leaveRequest       LeaveRequest?
  overtimeSheet      OvertimeSheet?
  flightApplication  FlightApplication?
  businessTrip       BusinessTrip?
  expenseClaim       ExpenseClaim?
  perDiemRequest     PerDiemRequest?
  perDiemSettlement  PerDiemSettlement?
  purchaseRequest      PurchaseRequest?
  materialRequisition  MaterialRequisition?
  consumablesRequisition ConsumablesRequisition?
  vehicleApplication     VehicleApplication?
  vehicleRefueling       VehicleRefueling?
  inspectionRepair       InspectionRepair?
  officialSeal            OfficialSeal?
  projectSeal            ProjectSeal?
  exitPermit             ExitPermit?
  fieldMovementLog       FieldMovementLog?
  siteAssignment         SiteAssignment?
  assetRequest           AssetRequest?
  assetAssignment        AssetAssignment?       @relation("AssetAssignmentApproval")

  @@index([categoryId], map: "idx_approval_request_category")
  @@index([companyId], map: "idx_approval_request_company")
  @@index([requestedBy], map: "idx_approval_request_requested_by")
  @@index([status], map: "idx_approval_request_status")
  @@map("approval_request")
}

model ApprovalTier {
  id         String               @id @default(uuid())
  requestId  String               @map("request_id")
  tierOrder  Int                  @map("tier_order")
  label      String
  approverId String               @map("approver_id")
  resolver   String
  decision   ApprovalTierDecision @default(PENDING)
  comment    String?
  conditions Json                 @default("[]")
  decidedAt  DateTime?            @map("decided_at") @db.Timestamp(6)
  /// Who clicked approve when a full-access user approved for the assigned approver.
  actingApproverId     String? @map("acting_approver_id")
  /// The assigned approver the tier was approved on behalf of (= approverId at the time).
  onBehalfOfApproverId String? @map("on_behalf_of_approver_id")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamp(6)

  request  ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approver User            @relation("TierApprover", fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actingApprover     User? @relation("TierActingApprover", fields: [actingApproverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  onBehalfOfApprover User? @relation("TierOnBehalfOfApprover", fields: [onBehalfOfApproverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approverId], map: "idx_approval_tier_approver")
  @@index([requestId], map: "idx_approval_tier_request")
  @@map("approval_tier")
}

model ApprovalComment {
  id           String   @id @default(uuid())
  requestId    String   @map("request_id")
  commentBy    String   @map("comment_by")
  commentText  String   @map("comment_text")
  attachmentId String?  @map("attachment_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commenter  User            @relation("ApprovalCommenter", fields: [commentBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachment Document?       @relation(fields: [attachmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("approval_comment")
}

model ApprovalResponse {
  id             String   @id @default(uuid())
  requestId      String   @map("request_id")
  responseType   String   @map("response_type")
  conditionIndex Int?     @map("condition_index")
  note           String?
  respondedBy    String   @map("responded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  request   ApprovalRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responder User                       @relation("ApprovalResponder", fields: [respondedBy], references: [id])
  documents ApprovalResponseDocument[]

  @@index([requestId], map: "idx_approval_response_request")
  @@map("approval_response")
}

model ApprovalResponseDocument {
  id         String   @id @default(uuid())
  responseId String   @map("response_id")
  documentId String   @map("document_id")
  createdAt  DateTime @default(now()) @map("created_at")

  response ApprovalResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  document Document         @relation(fields: [documentId], references: [id])

  @@index([responseId], map: "idx_approval_response_document_response")
  @@index([documentId], map: "idx_approval_response_document_document")
  @@map("approval_response_document")
}

// ─── Work Schedule & Public Holidays ─────────────────────────────────────────

/// STANDARD: late / early departure / missing punch rules. SCAN_ONLY: any scan
/// that day counts as present (e.g. cleaners finishing before office hours).
enum WorkScheduleCheckMode {
  STANDARD
  SCAN_ONLY
}

model WorkSchedule {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  isDefault   Boolean   @default(false) @map("is_default")
  isActive    Boolean   @default(true) @map("is_active")
  checkMode   WorkScheduleCheckMode @default(STANDARD) @map("check_mode")
  /// "HH:mm"; required when SCAN_ONLY. An earliest scan after this is flagged for HR review.
  latestScanTime String?  @map("latest_scan_time")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String    @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  company     Company                       @relation(fields: [companyId], references: [id])
  days        WorkScheduleDay[]
  assignments EmployeeScheduleAssignment[]
  employees   User[]                        @relation("EmployeeWorkSchedule")

  @@unique([companyId, name], map: "uq_work_schedule_company_name")
  @@index([companyId], map: "idx_work_schedule_company_id")
  @@index([companyId, isDefault], map: "idx_work_schedule_company_default")
  @@index([companyId, deletedAt], map: "idx_work_schedule_company_deleted")
  @@map("work_schedule")
}

model WorkScheduleDay {
  id             String  @id @default(uuid())
  scheduleId     String  @map("schedule_id")
  dayOfWeek      Int     @map("day_of_week")
  isWorkingDay   Boolean @default(true) @map("is_working_day")
  isHalfDay      Boolean @default(false) @map("is_half_day")
  morningStart   String? @map("morning_start")
  morningEnd     String? @map("morning_end")
  afternoonStart String? @map("afternoon_start")
  afternoonEnd   String? @map("afternoon_end")
  totalHours     Decimal @default(0) @map("total_hours") @db.Decimal(4, 1)

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayOfWeek], map: "uq_work_schedule_day_schedule_dow")
  @@index([scheduleId], map: "idx_work_schedule_day_schedule")
  @@map("work_schedule_day")
}

model EmployeeScheduleAssignment {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  employeeId    String    @map("employee_id")
  scheduleId    String    @map("schedule_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by")

  company  Company      @relation(fields: [companyId], references: [id])
  employee User         @relation(fields: [employeeId], references: [id])
  schedule WorkSchedule @relation(fields: [scheduleId], references: [id])

  @@index([employeeId, effectiveFrom], map: "idx_emp_sched_assign_employee_from")
  @@index([companyId], map: "idx_emp_sched_assign_company")
  @@index([scheduleId], map: "idx_emp_sched_assign_schedule")
  @@map("employee_schedule_assignment")
}

model PublicHoliday {
  id                   String             @id @default(uuid())
  companyId            String             @map("company_id")
  name                 String
  nameZh               String?            @map("name_zh")
  date                 DateTime           @db.Date
  isRecurring          Boolean            @default(false) @map("is_recurring")
  appliesToNationality HolidayNationality @default(ALL) @map("applies_to_nationality")
  isActive             Boolean            @default(true) @map("is_active")
  notes                String?
  notifyDaysBefore     Int                @default(2) @map("notify_days_before")
  createdAt            DateTime           @default(now()) @map("created_at")
  createdBy            String            @map("created_by")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  updatedBy            String            @map("updated_by")
  deletedAt            DateTime?          @map("deleted_at")
  deletedBy            String?            @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date, appliesToNationality], map: "uq_public_holiday_company_date_nat")
  @@index([companyId, date], map: "idx_public_holiday_company_date")
  @@index([companyId, isActive], map: "idx_public_holiday_company_active")
  @@index([companyId, deletedAt], map: "idx_public_holiday_company_deleted")
  @@map("public_holiday")
}

model WorkFromHomeDay {
  id            String            @id @default(uuid())
  companyId     String            @map("company_id")
  date          DateTime          @db.Date
  reason        String
  scope         WorkFromHomeScope @default(ALL)
  departmentIds String[]          @default([]) @map("department_ids")
  employeeIds   String[]          @default([]) @map("employee_ids")
  createdFromAttendanceImport Boolean @default(false) @map("created_from_attendance_import")
  createdAt     DateTime          @default(now()) @map("created_at")
  createdBy     String            @map("created_by")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  updatedBy     String            @map("updated_by")
  deletedAt     DateTime?         @map("deleted_at")
  deletedBy     String?           @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date], map: "uq_work_from_home_day_company_date")
  @@index([companyId], map: "idx_work_from_home_day_company")
  @@index([companyId, deletedAt], map: "idx_work_from_home_day_company_deleted")
  @@index([companyId, date], map: "idx_work_from_home_day_company_date")
  @@map("work_from_home_day")
}

model SiteAssignment {
  id                String               @id @default(uuid())
  companyId         String               @map("company_id")
  requestNumber     String               @map("request_number")
  employeeId        String               @map("employee_id")
  siteName          String               @map("site_name")
  projectName       String?              @map("project_name")
  projectId         String?              @map("project_id")
  startDate         DateTime             @map("start_date") @db.Date
  endDate           DateTime             @map("end_date") @db.Date
  reason            String?
  status            SiteAssignmentStatus @default(SUBMITTED)
  approvalRequestId String?              @unique @map("approval_request_id")
  isLateSubmission  Boolean              @default(false) @map("is_late_submission")
  lateReason        String?              @map("late_reason")
  submittedAt       DateTime?            @map("submitted_at")
  completedAt       DateTime?            @map("completed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  createdBy         String               @map("created_by")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  updatedBy         String               @map("updated_by")
  deletedAt         DateTime?            @map("deleted_at")
  deletedBy         String?              @map("deleted_by")
  createdFromAttendanceImport Boolean    @default(false) @map("created_from_attendance_import")
  /// Shared by the assignments created from one crew submission.
  crewId            String?              @map("crew_id")

  company         Company          @relation(fields: [companyId], references: [id])
  employee        User             @relation("SiteAssignmentEmployee", fields: [employeeId], references: [id])
  creator         User             @relation("SiteAssignmentCreator", fields: [createdBy], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id])
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  perDiemRequests PerDiemRequest[]
  overtimeEntries OvertimeEntry[]
  linkedFlightApplications FlightApplication[] @relation("FlightSiteAssignment")

  @@unique([companyId, requestNumber], map: "uq_site_assignment_company_number")
  @@index([companyId], map: "idx_site_assignment_company")
