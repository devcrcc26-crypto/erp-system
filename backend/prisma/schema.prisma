model Closeout {
  id                      String         @id @default(uuid())
  projectId               String         @unique @map("project_id")
  practicalCompletionDate DateTime?      @map("practical_completion_date") @db.Date
  defectsLiabilityEndDate DateTime?      @map("defects_liability_end_date") @db.Date
  finalCompletionDate     DateTime?      @map("final_completion_date") @db.Date
  status                  CloseoutStatus @default(PRACTICAL_COMPLETION)
  contractValue           Decimal?       @map("contract_value") @db.Decimal(18, 2)
  variationsTotal         Decimal?       @map("variations_total") @db.Decimal(18, 2)
  claimsTotal             Decimal?       @map("claims_total") @db.Decimal(18, 2)
  finalSettlement         Decimal?       @map("final_settlement") @db.Decimal(18, 2)
  createdAt               DateTime       @default(now()) @map("created_at")
  createdBy               String         @map("created_by")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  updatedBy               String         @map("updated_by")
  deletedAt               DateTime?      @map("deleted_at")
  deletedBy               String?        @map("deleted_by")

  project         Project                 @relation(fields: [projectId], references: [id])
  checklistItems  CloseoutChecklistItem[]
  warranties      Warranty[]

  @@index([projectId], map: "idx_closeout_project_id")
  @@index([projectId, deletedAt], map: "idx_closeout_project_deleted")
  @@index([deletedAt], map: "idx_closeout_deleted_at")
  @@map("closeout")
}

model CloseoutChecklistItem {
  id          String    @id @default(uuid())
  closeoutId  String    @map("closeout_id")
  verifiedBy  String?   @map("verified_by")
  category    String
  description String
  isComplete  Boolean   @default(false) @map("is_complete")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String    @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  closeout Closeout @relation(fields: [closeoutId], references: [id], onDelete: Cascade)
  verifier User?    @relation(fields: [verifiedBy], references: [id])

  @@index([closeoutId], map: "idx_closeout_checklist_closeout_id")
  @@index([closeoutId, deletedAt], map: "idx_closeout_checklist_closeout_deleted")
  @@index([deletedAt], map: "idx_closeout_checklist_deleted_at")
  @@map("closeout_checklist_item")
}

model Warranty {
  id              String    @id @default(uuid())
  closeoutId      String    @map("closeout_id")
