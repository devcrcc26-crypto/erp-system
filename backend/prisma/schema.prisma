// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserDiscipline {
  HIGHWAY
  HYDROLOGY
  STRUCTURE_ROAD
  GEOLOGICAL
  PAVEMENT_MATERIAL
  SURVEY
  ARCHITECTURE
  INTERIOR_DESIGN
  LANDSCAPE_DESIGN
  STRUCTURE_BUILDING
  SANITARY
  ELECTRICAL_ICT
  MECHANICAL
}

enum AuditLogSource {
  USER_ACTION
  SYSTEM_JOB
  API_INTEGRATION
  MIGRATION
}

enum FinancialYearStatus {
  OPEN
  CLOSED
}

enum FinancialPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum FolderContextType {
  SYSTEM
  COMPANY
  PROJECT
  DEPARTMENT
  USER
  TASK_DISCIPLINE
  RFI
  ISSUE
  SUBMITTAL
  DAILY_LOG
  MEETING
  CORRESPONDENCE
  RISK
  PUNCH_ITEM
  CHANGE_REQUEST
  APPROVAL
  LEAVE
  OVERTIME
  FLIGHT
  BUSINESS_TRIP
  EXPENSE_CLAIM
  PER_DIEM
  PURCHASE_REQUEST
  MATERIAL_REQUISITION
  CONSUMABLES_REQUISITION
  VEHICLE_APPLICATION
  VEHICLE_REFUELING
  INSPECTION_REPAIR
  OFFICIAL_SEAL
  PROJECT_SEAL
  EMPLOYEE_CONTRACT
  EMPLOYEE_PROFILE
  EXIT_PERMIT
  FIELD_MOVEMENT_LOG
  ANNOUNCEMENT
  ASSET_REQUEST
}

enum Nationality {
  ETHIOPIAN
  CHINESE
}

enum HolidayNationality {
  ETHIOPIAN
  CHINESE
  ALL
}

enum EmployeeType {
  PERMANENT
  CONTRACT
  TEMPORARY
  FREELANCER
}

/// Employment state, maintained by separation actions and the daily job (never edited directly).
enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SEPARATED
}

enum InactiveType {
  SUSPENDED
  LONG_LEAVE
  OTHER
}

enum SeparationType {
  RESIGNATION
  TERMINATION
  CONTRACT_END
  DEATH
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum EducationLevel {
  PHD
  MSC
  BSC
  DIPLOMA
  CERTIFICATE
  TECHNICIAN
  SECONDARY
  PRIMARY
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum NumberSeriesResetFrequency {
  NEVER
  YEARLY
  MONTHLY
}

enum CostCentreType {
  DIRECT
  INDIRECT
  OVERHEAD
}

enum CompanySettingDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum DataScopeType {
  COMPANY
  BRANCH
  DIVISION
  DEPARTMENT
  PROJECT
  SELF
}

enum EmailVerificationPurpose {
  ACCOUNT_ACTIVATION
  EMAIL_CHANGE
}

enum ApprovalRequestStatus {
  DRAFT
  PENDING
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  RETURNED
}

/// Capacity in which a request was filed: for yourself, as the direct supervisor
/// (reportsToUserId = submitter), or as a delegate (on-behalf scope / full access).
enum RequestInitiatorType {
  SELF
  SUPERVISOR
  DELEGATE
}

enum ApprovalTierDecision {
  PENDING
  APPROVED
  CONDITIONALLY_APPROVED
  REJECTED
  SKIPPED
  RETURNED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  PATERNITY
  EMERGENCY
  COMPASSIONATE
  STUDY
  EXAM
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum SiteAssignmentStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

/** Full day, or morning/afternoon half-day on a single full working weekday. */
enum LeaveDayPortion {
  FULL
  MORNING
  AFTERNOON

  @@map("leave_day_portion")
}

// ─── Company & Settings ──────────────────────────────────────────────────────

model Company {
  id                String    @id @default(uuid())
  legalName         String    @map("legal_name")
  registrationNumber String?  @map("registration_number")
  vatNumber         String?   @map("vat_number")
  logoUrl           String?   @map("logo_url")
  baseCurrency      String    @default("USD") @map("base_currency")
  defaultLanguage   String    @default("en") @map("default_language")
  defaultTimezone   String    @default("UTC") @map("default_timezone")
  defaultDateFormat String    @default("DD/MM/YYYY") @map("default_date_format")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String    @map("created_by")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String    @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")

  settings         CompanySetting[]
  branches         Branch[]
  divisions        Division[]
  departments      Department[]
  disciplines      Discipline[]
  costCentres      CostCentre[]
  positions        Position[]
  seniorityLevels  SeniorityLevel[]
  financialYears   FinancialYear[]
  financialPeriods FinancialPeriod[]
  numberSeries     NumberSeries[]
  users            User[]
  roles            Role[]
  auditLogs        AuditLog[]
  notificationTemplates NotificationTemplate[]
  notifications    Notification[]
  documentFolders  DocumentFolder[]
  documents        Document[]
  reportDefinitions ReportDefinition[]
  dashboardWidgets DashboardWidget[]
  projects                Project[]
  taskDisciplines         TaskDiscipline[]
  engineeringDocuments    EngineeringDocument[]
  engineeringDocVersions  EngineeringDocumentVersion[]
  designPackages          DesignPackage[]
  designPackageItems      DesignPackageItem[]
  designPackageDependencies DesignPackageDependency[]
  workflowEventLogs       WorkflowEventLog[]
  reviewSessions          ReviewSession[]
  reviewContextSnapshots  ReviewContextSnapshot[]
  reviewComments          ReviewComment[]
  submittalItems          SubmittalItem[]
  submittalSiteReviews    SubmittalSiteReview[]
  submittalExternalApprovals SubmittalExternalApproval[]
  submittalExternalFeedback  SubmittalExternalFeedback[]
  externalReviewTriggers  ExternalReviewTrigger[]
  deliverables            Deliverable[]
  changeRequests          ProjectChangeRequest[]
  rfis                    Rfi[]
  issues                  Issue[]
  correspondence          Correspondence[]
  punchItems              PunchItem[]
  dailyLogs               DailyLog[]
  taskDisciplineReviews    TaskDisciplineReview[]
  designPackageAttachments DesignPackageAttachment[]
  reviewSessionAttachments ReviewSessionAttachment[]
  approvalCategories       ApprovalCategory[]
  approvalRequests         ApprovalRequest[]
  leaveRequests            LeaveRequest[]
  leaveBalances            LeaveBalance[]
  leaveBalanceEntries      LeaveBalanceEntry[]
  overtimeSheets           OvertimeSheet[]
  flightApplications       FlightApplication[]
  businessTrips            BusinessTrip[]
  exchangeRates            ExchangeRate[]
  employeePerDiemRates     EmployeePerDiemRate[]
  expenseClaims            ExpenseClaim[]
  perDiemRequests          PerDiemRequest[]
  perDiemSettlements       PerDiemSettlement[]
  purchaseRequests         PurchaseRequest[]
  materialRequisitions     MaterialRequisition[]
  consumablesRequisitions  ConsumablesRequisition[]
  companyVehicles          CompanyVehicle[]
  vehicleApplications      VehicleApplication[]
  vehicleRefuelings        VehicleRefueling[]
  inspectionRepairs        InspectionRepair[]
  officialSeals            OfficialSeal[]
  projectSeals             ProjectSeal[]
  EmployeeContracts        EmployeeContract[]
  companyAssets            CompanyAsset[]
  assetAssignments         AssetAssignment[]
  assetRequests            AssetRequest[]
  leavePolicies            LeavePolicy[]
  ExitPermits              ExitPermit[]
  announcements            Announcement[]
  workSchedules               WorkSchedule[]
  publicHolidays              PublicHoliday[]
  workFromHomeDays            WorkFromHomeDay[]
  siteAssignments             SiteAssignment[]
  employeeScheduleAssignments EmployeeScheduleAssignment[]
  attendanceImportBatches  AttendanceImportBatch[]
  attendanceRecords        AttendanceRecord[]
  attendanceMonthlyApprovals AttendanceMonthlyApproval[]
  attendanceIdentities       AttendanceIdentity[]
  attendanceImportUnmatched  AttendanceImportUnmatched[]
  attendanceImportMissing    AttendanceImportMissing[]
  fieldMovementLogs          FieldMovementLog[]
  evaluationTemplates        EvaluationTemplate[]
  evaluationCycles           EvaluationCycle[]
  employeeEvaluations        EmployeeEvaluation[]
  payrollRuns                PayrollRun[]
  payrollEntries             PayrollEntry[]
  payrollEntryAudits         PayrollEntryAudit[]
  payrollPayslips            PayrollPayslip[]

  @@index([deletedAt], map: "idx_company_deleted_at")
  @@map("company")
}

model CompanySetting {
  id        String               @id @default(uuid())
  companyId String               @map("company_id")
  module    String
  key       String
  value     String
  dataType  CompanySettingDataType @default(STRING) @map("data_type")
  isPublic  Boolean              @default(false) @map("is_public")
  createdAt DateTime             @default(now()) @map("created_at")
  createdBy String               @map("created_by")
  updatedAt DateTime             @updatedAt @map("updated_at")
  updatedBy String               @map("updated_by")
  deletedAt DateTime?            @map("deleted_at")
  deletedBy String?              @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, module, key], map: "uq_company_setting_company_module_key")
  @@index([companyId], map: "idx_company_setting_company_id")
  @@index([companyId, deletedAt], map: "idx_company_setting_company_deleted")
  @@map("company_setting")
}

// ─── Organisation ────────────────────────────────────────────────────────────

model Branch {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  name         String
  address      String?
  city         String?
  country      String?
  phone        String?
  isHeadOffice Boolean   @default(false) @map("is_head_office")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]
  users       User[]
  projects    Project[]

  @@index([companyId], map: "idx_branch_company_id")
  @@index([companyId, deletedAt], map: "idx_branch_company_deleted")
  @@map("branch")
}

model Division {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  code        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String    @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]

  @@unique([companyId, code], map: "uq_division_company_code")
  @@index([companyId], map: "idx_division_company_id")
  @@index([companyId, deletedAt], map: "idx_division_company_deleted")
  @@map("division")
}

model Department {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  divisionId   String    @map("division_id")
  branchId     String    @map("branch_id")
  name         String
  nameZh       String?   @map("name_zh")
  code         String
  isActive     Boolean   @default(true) @map("is_active")
  leaderUserId String?   @map("leader_user_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  company     Company      @relation(fields: [companyId], references: [id])
  division    Division     @relation(fields: [divisionId], references: [id])
  branch      Branch       @relation(fields: [branchId], references: [id])
  leaderUser  User?        @relation("DepartmentLeader", fields: [leaderUserId], references: [id])
  costCentres CostCentre[]
  users       User[]
  projects    Project[]
  exitPermits ExitPermit[]

  @@unique([companyId, code], map: "uq_department_company_code")
  @@index([companyId], map: "idx_department_company_id")
  @@index([companyId, deletedAt], map: "idx_department_company_deleted")
  @@index([divisionId], map: "idx_department_division_id")
  @@index([branchId], map: "idx_department_branch_id")
  @@index([leaderUserId], map: "idx_department_leader_user_id")
  @@map("department")
}

/// Flat engineering discipline catalog (Highway, Structure, etc.) - not org HR department.
model Discipline {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  name          String
  nameZh        String?   @map("name_zh")
  isActive      Boolean   @default(true) @map("is_active")
  leaderId      String?   @map("leader_id")
  localLeaderId String?   @map("local_leader_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String    @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")

  company         Company          @relation(fields: [companyId], references: [id])
  leader          User?            @relation("DisciplineLeader", fields: [leaderId], references: [id])
  localLeader     User?            @relation("DisciplineLocalLeader", fields: [localLeaderId], references: [id])
  taskDisciplines TaskDiscipline[]
  users           User[]           @relation("UserEngineeringDiscipline")

  @@unique([companyId, name], map: "uq_engineering_discipline_company_name")
  @@index([companyId], map: "idx_engineering_discipline_company_id")
  @@index([companyId, deletedAt], map: "idx_engineering_discipline_company_deleted")
  @@index([companyId, isActive], map: "idx_engineering_discipline_company_active")
  @@index([leaderId], map: "idx_discipline_leader")
  @@index([localLeaderId], map: "idx_discipline_local_leader")
  @@map("engineering_discipline")
}

model CostCentre {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  departmentId String         @map("department_id")
  name         String
  code         String
  type         CostCentreType @default(DIRECT)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  createdBy    String         @map("created_by")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  updatedBy    String         @map("updated_by")
  deletedAt    DateTime?      @map("deleted_at")
  deletedBy    String?        @map("deleted_by")

  company    Company    @relation(fields: [companyId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([companyId, code], map: "uq_cost_centre_company_code")
  @@index([companyId], map: "idx_cost_centre_company_id")
  @@index([companyId, deletedAt], map: "idx_cost_centre_company_deleted")
  @@index([departmentId], map: "idx_cost_centre_department_id")
  @@map("cost_centre")
}

model Position {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  title     String
  titleZh   String?   @map("title_zh")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String    @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  @@index([companyId], map: "idx_position_company_id")
  @@index([companyId, deletedAt], map: "idx_position_company_deleted")
  @@map("position")
}

/// Seniority lookup (Junior / Middle / Senior …), managed in the app like positions.
model SeniorityLevel {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  name      String
  nameZh    String?   @map("name_zh")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String    @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  @@index([companyId], map: "idx_seniority_level_company_id")
  @@index([companyId, deletedAt], map: "idx_seniority_level_company_deleted")
  @@map("seniority_level")
}

// ─── Financial ───────────────────────────────────────────────────────────────

model FinancialYear {
  id        String              @id @default(uuid())
  companyId String              @map("company_id")
  name      String
  startDate DateTime            @map("start_date") @db.Date
  endDate   DateTime            @map("end_date") @db.Date
  status    FinancialYearStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")
  createdBy String              @map("created_by")
  updatedAt DateTime            @updatedAt @map("updated_at")
  updatedBy String              @map("updated_by")

  company  Company           @relation(fields: [companyId], references: [id])
  periods  FinancialPeriod[]

  @@index([companyId], map: "idx_financial_year_company_id")
  @@map("financial_year")
}

model FinancialPeriod {
  id                  String                @id @default(uuid())
  companyId           String                @map("company_id")
  financialYearId     String                @map("financial_year_id")
  name                String
  periodNumber        Int                   @map("period_number")
  startDate           DateTime              @map("start_date") @db.Date
  endDate             DateTime              @map("end_date") @db.Date
  status              FinancialPeriodStatus @default(OPEN)
  isAdjustmentPeriod  Boolean               @default(false) @map("is_adjustment_period")
  lockedAt            DateTime?             @map("locked_at")
  lockedBy            String?               @map("locked_by")
  closedAt            DateTime?             @map("closed_at")
  closedBy            String?               @map("closed_by")
  createdAt           DateTime              @default(now()) @map("created_at")
  createdBy           String                @map("created_by")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  updatedBy           String                @map("updated_by")

  company       Company       @relation(fields: [companyId], references: [id])
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@unique([financialYearId, periodNumber], map: "uq_financial_period_year_number")
  @@index([companyId], map: "idx_financial_period_company_id")
  @@index([financialYearId], map: "idx_financial_period_year_id")
  @@map("financial_period")
}

model NumberSeries {
  id             String                   @id @default(uuid())
  companyId      String                   @map("company_id")
  documentType   String                   @map("document_type")
  prefix         String                   @default("")
  suffix         String                   @default("")
  sequenceName   String                   @map("sequence_name")
  padding        Int                      @default(5)
  resetFrequency NumberSeriesResetFrequency @default(NEVER) @map("reset_frequency")
  createdAt      DateTime                 @default(now()) @map("created_at")
  createdBy      String                   @map("created_by")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  updatedBy      String                   @map("updated_by")
  deletedAt      DateTime?                @map("deleted_at")
  deletedBy      String?                  @map("deleted_by")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, documentType], map: "uq_number_series_company_doc_type")
  @@unique([sequenceName], map: "uq_number_series_sequence_name")
  @@index([companyId], map: "idx_number_series_company_id")
  @@index([companyId, deletedAt], map: "idx_number_series_company_deleted")
  @@map("number_series")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  companyId           String    @map("company_id")
  branchId            String?   @map("branch_id")
  departmentId            String?   @map("department_id")
  engineeringDisciplineId String?   @map("engineering_discipline_id")
  positionId          String?   @map("position_id")
  seniorityLevelId    String?   @map("seniority_level_id")
  reportsToUserId     String?   @map("reports_to_user_id")
  /// @deprecated Use engineeringDisciplineId - retained for migration/audit.
  discipline          UserDiscipline? @map("discipline")
  employeeId            String?         @unique @map("employee_id")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  middleName            String?         @map("middle_name")
  chineseName         String?   @map("chinese_name")
  /// OA login name (exact full name as used in company OA). Nullable until backfilled.
  loginName           String?   @unique(map: "uq_user_login_name") @map("login_name")
  /// Normalised loginName for case/whitespace-insensitive exact match.
  loginNameNormalized String?   @unique(map: "uq_user_login_name_normalized") @map("login_name_normalized")
  email               String?
  pendingEmail        String?   @map("pending_email")
  phone               String?
  secondaryPhone      String?   @map("secondary_phone")
  addressCountry        String?         @map("address_country")
  addressRegion         String?         @map("address_region")
  addressCity           String?         @map("address_city")
  addressSubcity        String?         @map("address_subcity")
  addressWoreda         String?         @map("address_woreda")
  addressHouseNumber    String?         @map("address_house_number")
  gender                Gender?
  dateOfBirth           DateTime?       @map("date_of_birth") @db.Date
  nationalId            String?         @map("national_id")
  tin                   String?         @map("tin")
  nationality           Nationality?
  employeeType          EmployeeType?   @map("employee_type")
  educationLevel        EducationLevel? @map("education_level")
  fieldOfStudy          String?         @map("field_of_study")
  /// Company hire / employment start date (payroll & attendance joiner window).
  employmentDate        DateTime?       @map("employment_date") @db.Date
  /// Career experience in years as entered by HR (never imported). The shown
  /// value is this plus the time elapsed since yearsOfExperienceAsOf.
  yearsOfExperience     Float?          @map("years_of_experience")
  /// Set by the server whenever yearsOfExperience is saved.
  yearsOfExperienceAsOf DateTime?       @map("years_of_experience_as_of") @db.Date
  emergencyContacts     Json?           @map("emergency_contacts")
  leavePolicyId         String?         @map("leave_policy_id")
  workScheduleId        String?         @map("work_schedule_id")
  profileFolderId       String?         @map("profile_folder_id")
  photoDocumentId       String?         @map("photo_document_id")
  passwordHash        String    @map("password_hash")
  preferredLanguage   String?   @map("preferred_language")
  preferredTimezone   String?   @map("preferred_timezone")
  preferredDateFormat String?   @map("preferred_date_format")
  bankName            String?   @map("bank_name")
  bankBranch          String?   @map("bank_branch")
  bankAccountNumber   String?   @map("bank_account_number")
  includeInPayroll    Boolean   @default(true) @map("include_in_payroll")
  attendanceMode      AttendanceMode @default(SCANNER) @map("attendance_mode")
  /// Approver-only accounts: never an HR-process subject (no leave, overtime,
  /// attendance or field movement of their own; not an on-behalf target).
  excludedFromHrProcesses Boolean @default(false) @map("excluded_from_hr_processes")
  excludedReason          String? @map("excluded_reason")
  /// "Can log in" only. Employment itself lives in employmentStatus / EmploymentPeriod.
  isActive            Boolean   @default(true) @map("is_active")
  employmentStatus    EmploymentStatus @default(ACTIVE) @map("employment_status")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  lastLogin           DateTime? @map("last_login")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String    @map("created_by")
