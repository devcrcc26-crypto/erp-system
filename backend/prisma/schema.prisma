  reviewSessionAttachments ReviewSessionAttachment[]
  submittalReviewAttachments SubmittalReview[]
  rfiResponses             RfiResponse[]             @relation("RfiResponseDocument")
  issueResponses           IssueResponse[]           @relation("IssueResponseDocument")
