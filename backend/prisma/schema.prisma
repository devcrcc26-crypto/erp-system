  returnDate               DateTime?               @map("return_date")
  kmAtDeparture            Decimal?                @map("km_at_departure") @db.Decimal(12, 2)
  kmAtReturn               Decimal?                @map("km_at_return") @db.Decimal(12, 2)
  purpose                  String
  ticketClass              FlightTicketClass       @default(ECONOMY) @map("ticket_class")
  accommodationRequired    Boolean                 @default(false) @map("accommodation_required")
  accommodationDetails     String?                 @map("accommodation_details")
  perDiemRequired          Boolean                 @default(false) @map("per_diem_required")
  notes                    String?
