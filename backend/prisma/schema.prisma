  policy LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

  @@unique([leavePolicyId, leaveType], map: "uq_leave_policy_rule_policy_type")
  @@index([leavePolicyId], map: "idx_leave_policy_rule_policy")
