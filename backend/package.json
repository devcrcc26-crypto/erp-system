{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:changed": "jest --onlyChanged",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed-approval-categories": "ts-node --transpile-only prisma/seed-approval-categories.ts",
    "prisma:seed-leave-policies": "ts-node --transpile-only prisma/seed-leave-policies.ts",
    "prisma:seed-employee-contract-permissions": "ts-node --transpile-only prisma/seed-employee-contract-permissions.ts",
    "prisma:seed-hr-users-permissions": "ts-node --transpile-only prisma/seed-hr-users-permissions.ts",
    "prisma:seed-announcement-permissions": "ts-node --transpile-only prisma/seed-announcement-permissions.ts",
    "prisma:seed-full-project": "ts-node --transpile-only prisma/seed-full-project.ts",
    "prisma:clear-pm": "ts-node --transpile-only prisma/clear-pm-data.ts",
    "prisma:recalculate-attendance-paid-days": "ts-node -r tsconfig-paths/register --transpile-only prisma/recalculate-attendance-paid-days.ts",
    "prisma:seed-payroll-test": "ts-node -r tsconfig-paths/register --transpile-only prisma/seed-payroll-test-data.ts",
    "prisma:seed-payroll-test-topup": "ts-node -r tsconfig-paths/register --transpile-only prisma/seed-payroll-test-topup.ts",
    "prisma:studio": "prisma studio",
    "sync:shared": "ts-node --transpile-only scripts/sync-shared-config.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.9.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.53.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "minio": "^8.0.5",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.32",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "hyperformula": "^3.5.0",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
